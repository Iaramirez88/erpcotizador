# ====== Base ======
POSTGRES_USER=sgdigital
POSTGRES_PASSWORD=sgdigital
POSTGRES_DB=sgdigital

# En docker-compose, usa el nombre del servicio postgres
DATABASE_URL=postgresql://sgdigital:sgdigital@postgres:5432/sgdigital

# NextAuth
NEXTAUTH_SECRET=<genera-con-openssl-rand-base64-32>
# Auth.js (NextAuth v5): en despliegues self-hosted suele requerirse
AUTH_TRUST_HOST=true
# URL pública (HTTPS recomendado en prod; se usa en Bold)
APP_URL=https://sgdigitalordex.com
# Dominio base para los sitios gratuitos: https://empresa.sgdigitalordex.com
NEXT_PUBLIC_WEBSITE_BASE_DOMAIN=sgdigitalordex.com
# Destinos válidos para dominios personalizados. Usa la IP pública real del VPS.
WEBSITE_DOMAIN_CNAME_TARGET=edge.sgdigitalordex.com
WEBSITE_DOMAIN_IPV4=
WEBSITE_DOMAIN_IPV6=

# Cloudflare Turnstile para formularios publicados (crea el widget para *.sgdigitalordex.com).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTS=sgdigitalordex.com
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=5
PUBLIC_FORM_RATE_LIMIT_PER_HOUR=30
PUBLIC_FORM_RATE_LIMIT_CHANNEL_DAILY=2000

# Memoria máxima de Node durante `npm run build` dentro de Docker.
# El paso "Running TypeScript ..." de `next build` corre en un worker que hereda
# NODE_OPTIONS; con 1536 MB muere por OOM ("Reached heap limit") en VPS pequeños.
# 4096 es el valor que usa CI. Antes de subirlo, confirma RAM/swap con `free -h`.
BUILD_MAX_OLD_SPACE_SIZE=4096

# Tokens compartidos (si no lo pones, se usa NEXTAUTH_SECRET en algunos endpoints)
SHARE_TOKEN_SECRET=<genera-otro-secreto-largo>
# Llave para endpoints administrativos disparados por cron o integraciones internas
ADMIN_API_KEY=replace-with-a-long-random-secret

# ====== OCR ======
# Dentro de docker, lo normal es apuntar al servicio "ocr"
OCR_SERVICE_URL=http://ocr:8001
#OCR_SERVICE_API_KEY=
OCR_SYNC_FALLBACK=false

# Límites recomendados para que OCR no se coma el VPS (docker-compose.prod.yml)
OCR_CPUS=0.75
OCR_MEM_LIMIT=2g
OCR_MEM_RESERVATION=512m
OCR_PIDS_LIMIT=256

# Limita paralelismo interno (Paddle/NumPy/BLAS)
OCR_OMP_NUM_THREADS=1
OCR_OPENBLAS_NUM_THREADS=1
OCR_MKL_NUM_THREADS=1
OCR_NUMEXPR_NUM_THREADS=1

# Cola OCR
REDIS_URL=redis://redis:6379
OCR_WORKER_CONCURRENCY=1

# ====== Scheduler snapshots Decision Engine ======
# Intervalo en segundos para recomputar snapshots consolidados.
DECISION_ENGINE_SNAPSHOT_INTERVAL_SECONDS=86400
DECISION_ENGINE_SNAPSHOT_LOCALE=es-CO
# Ejemplos: --only-company | --only-sedes | --empresa=<id> | --sede=<id>
DECISION_ENGINE_SNAPSHOT_ARGS=

# ====== Email (Resend) ======
RESEND_API_KEY="re_reemplazar"
EMAIL_FROM=SGDigital <no-reply@sgdigitalordex.com>

# ====== Bold ======
BOLD_IDENTITY_KEY=
BOLD_WEBHOOK_SECRET=
BOLD_VERIFY_WEBHOOK=true

# ====== Spaces/S3 (opcional) ======
# Si dejas S3_BUCKET vacío, se usa disco local (/app/public/scans)
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ====== LLM opcional para OCR ======
LLM_BASE_URL=
LLM_MODEL=llama3.1:8b
LLM_API_KEY=
DISABLE_MODEL_SOURCE_CHECK=True

SUPER_ADMIN_EMAIL=<tu-email@empresa.com>