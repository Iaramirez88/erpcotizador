// Schema de Base de Datos - SGDigital Cotizador Inteligente
// Generado: Diciembre 2025

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// MÓDULO DE AUTENTICACIÓN Y USUARIOS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  empresaId     String?
  empresa       Empresa?  @relation(fields: [empresaId], references: [id])

  lastLoginAt   DateTime?

  // Preferencias de UI (menú, reportes)
  uiPreference UiPreference?

  // Plantilla PDF de cotización (configurable por usuario)
  cotizacionTemplate CotizacionTemplate?
  
  // Plantilla PDF de remisión (configurable por usuario)
  remisionTemplate RemisionTemplate?

  // Relaciones NextAuth
  accounts Account[]
  sessions Session[]

  // Relaciones del negocio
  cotizaciones Cotizacion[] @relation("CotizacionVendedor")
  cotizacionesAsignadas Cotizacion[] @relation("CotizacionAssignedTo")
  ordenes      OrdenTrabajo[] @relation("OrdenVendedor")
  ordenesAsignadas OrdenTrabajo[] @relation("OrdenAssignedTo")

  // Escaneo de documentos (IA/OCR)
  documentScans     DocumentScan[]              @relation("ScanCreatedBy")
  approvedScans     DocumentScan[]              @relation("ScanApprovedBy")
  scanFieldFeedback DocumentScanFieldFeedback[]

  // Compras
  comprasCreadas     Compra[]     @relation("CompraCreadaPor")
  comprasAutorizadas Compra[]     @relation("CompraAutorizadoPor")
  comprasRecibidas   Compra[]     @relation("CompraRecibidoPor")
  compraPagosCreados CompraPago[] @relation("CompraPagoCreadoPor")

  // Seguridad: verificación de email y restablecimiento de contraseña
  emailVerificationCodes EmailVerificationCode[]
  passwordResetTokens    PasswordResetToken[]

  // RBAC por sede / equipos
  sedeMemberships SedeMembership[]
  teamMemberships TeamMember[]
  moduleAccess    UserModuleAccess[]
  globalAccess    UserGlobalAccess?

  // Notificaciones
  notifications Notification[]

  // Inventario
  inventoryMovements InventoryMovement[]

  // POS (facturación interna)
  posInvoicesCreated PosInvoice[] @relation("PosInvoiceCreatedBy")
  posReturnsCreated  PosReturn[]  @relation("PosReturnCreatedBy")

  // DIAN (documentos electrónicos)
  dianDocumentsCreated DianElectronicDocument[] @relation("DianDocCreatedBy")

  // Remisiones
  remisionesCreadas Remision[] @relation("RemisionCreatedBy")
  remisionesAsignadas Remision[] @relation("RemisionAssignedTo")
  
  // Traslados de inventario
  transfersCreated   InventoryTransfer[] @relation("TransferCreated")
  transfersCompleted InventoryTransfer[] @relation("TransferCompleted")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model EmailVerificationCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  codeHash  String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@map("email_verification_codes")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@map("password_reset_tokens")
}

model RegistrationInvite {
  id       String @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  email    String
  codeHash String @db.Text

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([empresaId, email])
  @@map("registration_invites")
}

model CotizacionTemplate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  settings Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cotizacion_templates")
}

model RemisionTemplate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  settings Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("remision_templates")
}

model UiPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nav      Json @default("{}")
  report   Json @default("{}")
  tutorial Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ui_preferences")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  ADMIN
  USER
  VENDEDOR
  PRODUCCION
  CLIENTE
}

// ============================================
// PLANES / SUSCRIPCIÓN (MVP)
// ============================================

enum PlanTier {
  BASIC
  MEDIO
  INTERMEDIO
  FULL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum BillingProvider {
  BOLD
}

enum BillingInvoiceStatus {
  PENDING
  PAID
  REJECTED
  VOID
  EXPIRED
}

// ============================================
// RBAC POR SEDE (MVP)
// ============================================

enum SedeRole {
  ADMIN
  MANAGER
  MEMBER
  READER
}

enum TeamRole {
  LEAD
  MEMBER
}

enum ModuleKey {
  DASHBOARD
  COTIZADOR
  COTIZACIONES
  CLIENTES
  MATERIALES
  INVENTARIO
  REMISIONES
  POS
  PROVEEDORES
  COMPRAS
  ORDENES
  ESCANEOS
  REPORTES
  NOTIFICACIONES
  CONFIG
}

enum AccessLevel {
  NONE
  READ
  WRITE
  ADMIN
}

// ============================================
// NOTIFICACIONES (MVP)
// ============================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ============================================
// INVENTARIO (MVP)
// ============================================

enum InventoryMovementType {
  IN
  OUT
  ADJUST
}

enum InventoryMovementSourceType {
  MANUAL
  POS_INVOICE
  POS_RETURN
  REMISION
  TRANSFER
}

enum RemisionStatus {
  EMITIDA
  ANULADA
}

enum InventoryTransferStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum PosInvoiceStatus {
  DRAFT
  PAID
  VOID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PosPaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

// ============================================
// FACTURACIÓN ELECTRÓNICA (DIAN) - MVP
// ============================================

enum DianDocumentDirection {
  OUTBOUND
  INBOUND
}

enum DianDocumentType {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  ELECTRONIC_INSTRUMENT
}

enum DianDocumentStatus {
  GENERATED
  TRANSMITTED
  EXPEDITED
  DELIVERED
  RECEIVED
  ERROR
}

enum DianEventType {
  GENERATION
  TRANSMISSION
  EXPEDITION
  DELIVERY
  RECEPTION
  ERROR
  NOTE
}

// ============================================
// MÓDULO DE EMPRESA
// ============================================

model Empresa {
  id        String  @id @default(cuid())
  nombre    String
  nit       String  @unique
  direccion String?
  telefono  String?
  email     String?
  logo      String?

  // Código de acceso para permitir registro de usuarios en esta empresa.
  // Se guarda hasheado (bcrypt). Si es null, el registro es abierto.
  registrationCodeHash String? @db.Text

  registrationInvites RegistrationInvite[]

  planTier     PlanTier     @default(FULL)
  billingCycle BillingCycle @default(MONTHLY)

  // Vigencia del acceso por plan (Bold no expone suscripciones recurrentes públicas en docs;
  // se maneja por periodo pagado y renovaciones).
  planValidUntil DateTime?

  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripePriceId            String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?
  stripeCancelAtPeriodEnd  Boolean   @default(false)

  billingInvoices BillingInvoice[]

  inventoryMovements InventoryMovement[]

  // Bodegas / stock / POS
  warehouses  InventoryWarehouse[]
  posInvoices PosInvoice[]
  posReturns  PosReturn[]

  // DIAN (documentos electrónicos)
  dianDocuments DianElectronicDocument[]

  usuarios       User[]
  globalAccesses UserGlobalAccess[]
  clientes       Cliente[]
  materiales     Material[]
  terminados     Terminado[]
  maquinas       Maquina[]

  remisiones Remision[]

  proveedores Proveedor[]
  compras     Compra[]
  compraPagos CompraPago[]

  sedes         Sede[]
  notifications Notification[]

  // Tarifario global de Litografía (misma configuración para todas las sedes)
  litografiaPrintProfiles LitografiaPrintProfile[]
  litografiaPaperRates    LitografiaPaperRate[]
  litografiaFlyerRates    LitografiaFlyerRate[]
  litografiaProductos     LitografiaProducto[]
  litografiaFinishOptions LitografiaFinishOption[]
  litografiaPrintSizes    LitografiaPrintSize[]
  
  inventoryTransfers InventoryTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("empresas")
}

// ============================================
// LITOGRAFÍA - TARIFARIO GLOBAL (POR EMPRESA)
// ============================================

model LitografiaPrintProfile {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre String

  // Costos por pliego (por color)
  costoPlanchaPorColor Float @default(0)
  costoTintaPorColor   Float @default(0)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("litografia_print_profiles")
}

model LitografiaPaperRate {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre  String
  tipo    String?
  gramaje Int?

  // Tamaño de pliego base (cm)
  pliegoWidthCm  Float @default(70)
  pliegoHeightCm Float @default(100)

  // Costo por pliego
  costoPliego Float @default(0)

  activo Boolean @default(true)

  flyerRates LitografiaFlyerRate[]
  productos  LitografiaProducto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("litografia_paper_rates")
}

model LitografiaFinishOption {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  key    String
  nombre String

  // Valor/costo del acabado (COP). Se usa para referencia y futuras reglas.
  valor Float @default(0)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flyerRates LitografiaFlyerRate[]
  productos  LitografiaProducto[]

  @@unique([empresaId, key])
  @@index([empresaId, activo])
  @@map("litografia_finish_options")
}

model LitografiaPrintSize {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Debe coincidir con el formatoKey usado en tarifario y cotizador
  key    String
  nombre String

  widthCm  Float @default(0)
  heightCm Float @default(0)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, key])
  @@index([empresaId, activo])
  @@map("litografia_print_sizes")
}

model LitografiaProducto {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre      String
  descripcion String?

  // Especificación del producto (define el “ítem” y sus rangos)
  formatoKey String
  tintas     Int

  // Papel requerido para calcular pliegos/imposición
  paperRateId String
  paperRate   LitografiaPaperRate @relation(fields: [paperRateId], references: [id])

  finishOptionId String?
  finishOption   LitografiaFinishOption? @relation(fields: [finishOptionId], references: [id], onDelete: SetNull)

  activo Boolean @default(true)

  flyerRates LitografiaFlyerRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@unique([empresaId, paperRateId, formatoKey, tintas, finishOptionId])
  @@index([empresaId, activo])
  @@index([empresaId, formatoKey, tintas])
  @@map("litografia_productos")
}

model LitografiaFlyerRate {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  productoId String?
  producto   LitografiaProducto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  // Debe coincidir con LitografiaPrintSize.key (o PRODUCT_PRESETS.key si no usa tamaños configurables)
  formatoKey String

  // Solo permitidos: 1, 2, 4 (4 = policromía)
  tintas Int

  // Rango inclusivo: tirajeMin <= cantidad <= tirajeMax
  tirajeMin Int
  tirajeMax Int

  // Opcionales para tarifario completo por papel y acabado
  paperRateId String?
  paperRate   LitografiaPaperRate? @relation(fields: [paperRateId], references: [id], onDelete: SetNull)

  finishOptionId String?
  finishOption   LitografiaFinishOption? @relation(fields: [finishOptionId], references: [id], onDelete: SetNull)

  // Precio TOTAL (no unitario) para ese rango/opción
  precioTotal Float @default(0)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, formatoKey, tintas, tirajeMin, tirajeMax, paperRateId, finishOptionId])
  @@index([empresaId, formatoKey, tintas, paperRateId, finishOptionId, activo])
  @@index([empresaId, productoId, activo])
  @@index([empresaId, tirajeMin, tirajeMax])
  @@map("litografia_flyer_rates")
}

model InventoryMovement {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Multi-sede / bodega (para POS y control por almacén)
  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: SetNull)

  warehouseId String?
  warehouse   InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  type     InventoryMovementType
  // Delta aplicado (IN: positivo, OUT: negativo, ADJUST: diferencia)
  quantity Float

  stockBefore Float
  stockAfter  Float

  note String?

  sourceType InventoryMovementSourceType @default(MANUAL)
  sourceId   String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([sedeId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([sourceType, sourceId])
  @@index([materialId, createdAt])
  @@map("inventory_movements")
}

model InventoryWarehouse {
  id        String  @id @default(cuid())
  nombre    String
  codigo    String?
  isDefault Boolean @default(false)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Multi-sede (opcional por compatibilidad / despliegues iniciales)
  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  stocks    InventoryStock[]
  movements InventoryMovement[]

  posInvoices PosInvoice[]
  posReturns  PosReturn[]

  remisiones Remision[]
  
  transfersFrom InventoryTransfer[] @relation("TransfersFrom")
  transfersTo   InventoryTransfer[] @relation("TransfersTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, sedeId, nombre])
  @@index([empresaId])
  @@index([sedeId])
  @@map("inventory_warehouses")
}

model InventoryStock {
  id          String             @id @default(cuid())
  warehouseId String
  warehouse   InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  quantity Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, materialId])
  @@index([materialId])
  @@map("inventory_stocks")
}

model InventoryTransfer {
  id     String @id @default(cuid())
  numero String @unique

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Bodega origen
  fromWarehouseId String
  fromWarehouse   InventoryWarehouse @relation("TransfersFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)

  // Bodega destino
  toWarehouseId String
  toWarehouse   InventoryWarehouse @relation("TransfersTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  quantity Float
  note     String?

  status InventoryTransferStatus @default(PENDIENTE)

  createdById String?
  createdBy   User?   @relation("TransferCreated", fields: [createdById], references: [id], onDelete: SetNull)

  completedById String?
  completedBy   User?    @relation("TransferCompleted", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, createdAt])
  @@index([fromWarehouseId, createdAt])
  @@index([toWarehouseId, createdAt])
  @@index([materialId, createdAt])
  @@index([status])
  @@map("inventory_transfers")
}

model PosSequence {
  id     String @id @default(cuid())
  sedeId String @unique
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  nextInvoiceNumber Int @default(1)
  nextReturnNumber  Int @default(1)

  updatedAt DateTime @updatedAt

  @@map("pos_sequences")
}

model CotizacionSequence {
  sedeId String @id
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  currentNumber Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cotizacion_sequences")
}

model PosInvoice {
  id     String           @id @default(cuid())
  numero String           @unique
  status PosInvoiceStatus @default(PAID)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  clienteNombre    String
  clienteDocumento String?

  ivaPct   Float @default(0)
  subtotal Float @default(0)
  iva      Float @default(0)
  total    Float @default(0)

  note String? @db.Text

  items    PosInvoiceItem[]
  payments PosPayment[]
  returns  PosReturn[]

  // DIAN (documentos electrónicos)
  dianDocuments DianElectronicDocument[] @relation("DianDocPosInvoice")

  createdById String?
  createdBy   User?   @relation("PosInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, createdAt])
  @@index([sedeId, createdAt])
  @@map("pos_invoices")
}

model PosInvoiceItem {
  id        String     @id @default(cuid())
  invoiceId String
  invoice   PosInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  descripcion String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([materialId])
  @@map("pos_invoice_items")
}

model PosPayment {
  id        String     @id @default(cuid())
  invoiceId String
  invoice   PosInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  method PosPaymentMethod
  amount Float            @default(0)
  note   String?

  receivedAt DateTime @default(now())

  @@index([invoiceId])
  @@map("pos_payments")
}

model PosReturn {
  id     String @id @default(cuid())
  numero String @unique

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   PosInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  motivo   String? @db.Text
  ivaPct   Float   @default(0)
  subtotal Float   @default(0)
  iva      Float   @default(0)
  total    Float   @default(0)

  items PosReturnItem[]

  // DIAN (documentos electrónicos)
  dianDocuments DianElectronicDocument[] @relation("DianDocPosReturn")

  createdById String?
  createdBy   User?   @relation("PosReturnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([sedeId, createdAt])
  @@index([invoiceId])
  @@map("pos_returns")
}

model PosReturnItem {
  id        String    @id @default(cuid())
  returnId  String
  posReturn PosReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  descripcion String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)

  @@index([returnId])
  @@index([materialId])
  @@map("pos_return_items")
}

model DianElectronicDocument {
  id        String @id @default(cuid())
  direction DianDocumentDirection @default(OUTBOUND)
  type      DianDocumentType
  status    DianDocumentStatus @default(GENERATED)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String
  sede   Sede @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  // Opcional: documento interno origen
  posInvoiceId String?
  posInvoice   PosInvoice? @relation("DianDocPosInvoice", fields: [posInvoiceId], references: [id], onDelete: SetNull)

  posReturnId String?
  posReturn   PosReturn? @relation("DianDocPosReturn", fields: [posReturnId], references: [id], onDelete: SetNull)

  // Identificadores y payload
  numero      String?
  uuid        String?
  cufe        String? @db.Text
  provider    String?
  providerRef String?

  payload Json @default("{}")
  xml     String? @db.Text

  lastError String? @db.Text

  transmittedAt DateTime?
  expeditedAt   DateTime?
  deliveredAt   DateTime?
  receivedAt    DateTime?

  createdById String?
  createdBy   User? @relation("DianDocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  events DianElectronicEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, createdAt])
  @@index([sedeId, createdAt])
  @@index([direction, status, createdAt])
  @@index([posInvoiceId])
  @@index([posReturnId])
  @@map("dian_electronic_documents")
}

model DianElectronicEvent {
  id         String @id @default(cuid())
  documentId String
  document   DianElectronicDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  type    DianEventType
  message String? @db.Text
  meta    Json @default("{}")

  createdAt DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([type, createdAt])
  @@map("dian_electronic_events")
}

model BillingInvoice {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  provider BillingProvider      @default(BOLD)
  status   BillingInvoiceStatus @default(PENDING)

  planTier     PlanTier
  billingCycle BillingCycle

  currency    String @default("COP")
  amountCOP   Int
  discountPct Int    @default(0)

  externalReference String @unique

  boldPaymentLinkId String? @unique
  boldCheckoutUrl   String?
  boldPaymentId     String?
  boldEventId       String?
  boldType          String?

  expiresAt DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([empresaId, status])
  @@index([externalReference])
  @@map("billing_invoices")
}

// ============================================
// SEDES / EQUIPOS / PERMISOS (MVP)
// ============================================

model Sede {
  id     String  @id @default(cuid())
  nombre String
  codigo String?

  // Configuración de cotizaciones por sede
  cotizacionesPricesIncludeIva Boolean @default(true)
  cotizacionesIvaPct           Float   @default(19)

  // Desperdicios (configuración por sede)
  desperdicioPctDefault Float @default(0)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  memberships   SedeMembership[]
  teams         Team[]
  moduleAccess  UserModuleAccess[]
  notifications Notification[]

  cotizaciones      Cotizacion[]                @relation("SedeCotizaciones")
  ordenes           OrdenTrabajo[]              @relation("SedeOrdenes")
  clientes          Cliente[]
  compras           Compra[]                    @relation("SedeCompras")
  compraPagos       CompraPago[]                @relation("SedeCompraPagos")
  documentScans     DocumentScan[]              @relation("SedeScans")
  scanFieldFeedback DocumentScanFieldFeedback[]

  // Inventario / bodegas / POS
  inventoryMovements InventoryMovement[]
  warehouses         InventoryWarehouse[]
  posSequence        PosSequence?
  cotizacionSequence CotizacionSequence?
  remisionSequence   RemisionSequence?
  posInvoices        PosInvoice[]
  posReturns         PosReturn[]

  // DIAN (documentos electrónicos)
  dianDocuments DianElectronicDocument[]

  remisiones Remision[]

  desperdiciosMateriales SedeMaterialWaste[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@map("sedes")
}

model RemisionSequence {
  sedeId String @id
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  currentNumber Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("remision_sequences")
}

model Remision {
  id     String         @id @default(cuid())
  numero String         @unique
  status RemisionStatus @default(EMITIDA)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  clienteNombre String?
  note          String?

  createdById String?
  createdBy   User?   @relation("RemisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignedToUserId String?
  assignedTo       User?   @relation("RemisionAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedAt       DateTime?

  items RemisionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, createdAt])
  @@index([sedeId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([assignedToUserId])
  @@map("remisiones")
}

model RemisionItem {
  id         String   @id @default(cuid())
  remisionId String
  remision   Remision @relation(fields: [remisionId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  quantity Float
  note     String?

  createdAt DateTime @default(now())

  @@index([remisionId])
  @@index([materialId])
  @@map("remision_items")
}

model SedeMembership {
  id     String   @id @default(cuid())
  sedeId String
  userId String
  role   SedeRole @default(READER)

  sede Sede @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, userId])
  @@index([userId])
  @@map("sede_memberships")
}

model Team {
  id          String  @id @default(cuid())
  sedeId      String
  nombre      String
  descripcion String?

  sede    Sede         @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  members TeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@map("teams")
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole @default(MEMBER)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model UserModuleAccess {
  id     String      @id @default(cuid())
  sedeId String
  userId String
  module ModuleKey
  level  AccessLevel @default(READ)

  sede Sede @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, userId, module])
  @@index([userId])
  @@map("user_module_access")
}

model UserGlobalAccess {
  id        String      @id @default(cuid())
  userId    String      @unique
  empresaId String
  level     AccessLevel @default(READ)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@map("user_global_access")
}

// ============================================
// NOTIFICACIONES (MVP)
// ============================================

model Notification {
  id    String           @id @default(cuid())
  type  NotificationType @default(INFO)
  title String
  body  String?

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([empresaId])
  @@index([sedeId])
  @@map("notifications")
}

// ============================================
// MÓDULO DE CLIENTES
// ============================================

enum ClienteSegmento {
  POTENCIAL
  OCASIONAL
  FRECUENTE
}

model Cliente {
  id            String  @id @default(cuid())
  nombre        String
  tipoDocumento String // NIT, CC, CE
  documento     String  @unique
  email         String?
  telefono      String?
  celular       String?
  direccion     String?
  ciudad        String?
  departamento  String?

  // Segmento definido manualmente (opcional). Si es null, puede calcularse en la API.
  segmento ClienteSegmento?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  // Sede asociada (opcional). Útil para segmentar clientes por sede.
  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: SetNull)

  cotizaciones Cotizacion[]
  ordenes      OrdenTrabajo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, nombre], map: "idx_clientes_empresa_nombre")
  @@index([sedeId])

  @@map("clientes")
}

// ============================================
// MÓDULO DE COTIZACIONES (FASE 1)
// ============================================

model Cotizacion {
  id          String   @id @default(cuid())
  numero      String // COT-2025-0001
  fecha       DateTime @default(now())
  validezDias Int      @default(15)

  // Multi-sede (MVP): opcional para compatibilidad con registros antiguos
  sedeId String?
  sede   Sede?   @relation("SedeCotizaciones", fields: [sedeId], references: [id])

  // Tracking de envíos
  emailSentCount     Int       @default(0)
  whatsappSentCount  Int       @default(0)
  lastEmailSentAt    DateTime?
  lastWhatsappSentAt DateTime?

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String
  vendedor   User   @relation("CotizacionVendedor", fields: [vendedorId], references: [id])

  assignedToUserId String?
  assignedTo       User?   @relation("CotizacionAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedAt       DateTime?

  items ItemCotizacion[]

  subtotal  Float @default(0)
  descuento Float @default(0)
  iva       Float @default(0)
  total     Float @default(0)

  // Condiciones / pagos
  garantia          String?  @db.Text
  paymentMethods    String[] @default([])
  boldPaymentLinkId String?  @unique
  boldCheckoutUrl   String?

  estado        EstadoCotizacion @default(BORRADOR)
  observaciones String?          @db.Text

  // Conversión a orden
  orden OrdenTrabajo? @relation("CotizacionOrden")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, createdAt], map: "idx_cotizaciones_estado_created")
  @@index([sedeId, createdAt], map: "idx_cotizaciones_sede_created")
  @@index([sedeId, estado], map: "idx_cotizaciones_sede_estado")
  @@index([sedeId])
  @@index([assignedToUserId])
  @@unique([sedeId, numero], map: "uq_cotizaciones_sede_numero")
  @@map("cotizaciones")
}

model ItemCotizacion {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  descripcion String
  cantidad    Float
  unidad      String // m2, unidad, ml

  // Dimensiones
  ancho Float?
  alto  Float?
  area  Float? // Calculado automáticamente

  // Desperdicio (por item)
  desperdicioPct Float @default(0)

  // Materiales
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  // Acabados
  laminado    Boolean @default(false)
  troquelado  Boolean @default(false)
  instalacion Boolean @default(false)

  // Costos
  costoMaterial    Float @default(0)
  costoImpresion   Float @default(0)
  costoAcabados    Float @default(0)
  costoInstalacion Float @default(0)
  precioUnitario   Float
  subtotal         Float

  orden Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terminados ItemCotizacionTerminado[]

  @@index([cotizacionId], map: "idx_items_cotizacion_cot")
  @@map("items_cotizacion")
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
  VENCIDA
  CONVERTIDA
}

// ============================================
// MÓDULO DE MATERIALES Y PRECIOS
// ============================================

model Material {
  id        String       @id @default(cuid())
  nombre    String
  tipo      TipoMaterial
  categoria String?

  // Imagen del producto/servicio (URL pública o ruta absoluta/relativa)
  imagenUrl String?

  // Especificaciones
  ancho   Float? // En cm
  largo   Float? // En cm o metros
  espesor Float? // En mm
  color   String?

  // Precios
  precioM2     Float?
  precioMetro  Float?
  precioUnidad Float?
  precioCompra Float?

  remisionItems RemisionItem[]

  // Stock
  stockActual  Float  @default(0)
  stockMinimo  Float  @default(0)
  unidadMedida String // m2, ml, unidad

  proveedor     String?
  observaciones String? @db.Text

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  items ItemCotizacion[]

  sedeWastes SedeMaterialWaste[]

  quantityDiscounts MaterialQuantityDiscount[]

  inventoryMovements InventoryMovement[]
  stocks             InventoryStock[]
  inventoryTransfers InventoryTransfer[]

  posInvoiceItems PosInvoiceItem[]
  posReturnItems  PosReturnItem[]

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, activo], map: "idx_materiales_empresa_activo")
  @@map("materiales")
}

model SedeMaterialWaste {
  id         String @id @default(cuid())
  sedeId     String
  materialId String

  desperdicioPct Float @default(0)

  sede     Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, materialId])
  @@index([materialId])
  @@index([sedeId])
  @@map("sede_material_waste")
}

model MaterialQuantityDiscount {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  // Descuento aplicable cuando cantidad >= minQty
  minQty      Float
  discountPct Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, minQty])
  @@index([materialId])
  @@map("material_quantity_discounts")
}

// ============================================
// TERMINADOS (catálogo de acabados)
// ============================================

model Terminado {
  id String @id @default(cuid())

  nombre           String
  unidadAplicacion String // m2, ml, unidad
  precioUnitario   Float  @default(0)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  items ItemCotizacionTerminado[]

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("terminados")
}

model ItemCotizacionTerminado {
  id String @id @default(cuid())

  itemCotizacionId String
  itemCotizacion   ItemCotizacion @relation(fields: [itemCotizacionId], references: [id], onDelete: Cascade)

  terminadoId String
  terminado   Terminado @relation(fields: [terminadoId], references: [id], onDelete: Cascade)

  unidadAplicacion String
  baseCantidad     Float  @default(0)
  precioUnitario   Float  @default(0)
  costoTotal       Float  @default(0)

  createdAt DateTime @default(now())

  @@unique([itemCotizacionId, terminadoId])
  @@index([terminadoId])
  @@index([itemCotizacionId])
  @@map("item_cotizacion_terminados")
}

enum TipoMaterial {
  VINILO
  LONA
  BANNER
  MICROPERFORADO
  ONE_WAY
  ADHESIVO
  PAPEL
  CARTULINA
  FOAM
  ACRILICO
  PVC
  OTRO
}

// ============================================
// MÓDULO DE ÓRDENES DE TRABAJO (FASE 2)
// ============================================

model OrdenTrabajo {
  id           String    @id @default(cuid())
  numero       String    @unique // OT-2025-0001
  fecha        DateTime  @default(now())
  fechaEntrega DateTime?

  // Multi-sede (MVP): opcional para compatibilidad con registros antiguos
  sedeId String?
  sede   Sede?   @relation("SedeOrdenes", fields: [sedeId], references: [id])

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String
  vendedor   User   @relation("OrdenVendedor", fields: [vendedorId], references: [id])

  assignedToUserId String?
  assignedTo       User?   @relation("OrdenAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?

  // Referencia a cotización
  cotizacionId String?     @unique
  cotizacion   Cotizacion? @relation("CotizacionOrden", fields: [cotizacionId], references: [id])

  // Valores financieros
  subtotal  Float @default(0)
  descuento Float @default(0)
  iva       Float @default(0)
  total     Float @default(0)

  // Proceso de producción
  etapas EtapaProduccion[]

  estado    EstadoOrden @default(PENDIENTE)
  prioridad Prioridad   @default(NORMAL)

  observaciones  String? @db.Text
  archivosDiseno Json? // URLs de archivos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, createdAt], map: "idx_ordenes_estado_created")
  @@index([sedeId, createdAt], map: "idx_ordenes_sede_created")
  @@index([sedeId, estado], map: "idx_ordenes_sede_estado")
  @@index([sedeId])
  @@index([assignedToUserId])
  @@map("ordenes_trabajo")
}

model EtapaProduccion {
  id      String       @id @default(cuid())
  ordenId String
  orden   OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  nombre    String // Diseño, Preprensa, Impresión, Acabados, Entrega
  secuencia Int // Orden de la etapa (1, 2, 3, etc.)

  maquinaId String?
  maquina   Maquina? @relation(fields: [maquinaId], references: [id])

  estado EstadoEtapa @default(PENDIENTE)

  fechaInicio    DateTime?
  fechaFin       DateTime?
  tiempoEstimado Int? // En minutos
  tiempoReal     Int? // En minutos

  responsable   String?
  observaciones String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("etapas_produccion")
}

model Maquina {
  id     String  @id @default(cuid())
  nombre String
  tipo   String // Plotter, Impresora, Laminadora, etc.
  marca  String?
  modelo String?

  anchoMax  Float? // En cm
  velocidad Float? // m2/hora

  estado EstadoMaquina @default(DISPONIBLE)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  etapas EtapaProduccion[]

  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maquinas")
}

enum EstadoOrden {
  PENDIENTE
  RECIBIDO
  COTIZADO
  APROBADO
  EN_DISENO
  EN_CORRECCION
  APROBADO_PRODUCCION
  EN_IMPRESION
  EN_PRODUCCION
  EN_ACONDICIONAMIENTO
  EN_ACABADOS
  EN_ENTREGA
  LISTA_ENTREGA
  ENTREGADA
  FACTURADO
  CERRADO
  CANCELADA
}

enum EstadoEtapa {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  DETENIDA
}

enum EstadoMaquina {
  DISPONIBLE
  EN_USO
  MANTENIMIENTO
  FUERA_SERVICIO
}

enum Prioridad {
  BAJA
  NORMAL
  ALTA
  URGENTE
}

// ============================================
// MÓDULO DE ESCANEO (IA/OCR) - FACTURAS/COTIZACIONES
// ============================================

enum ScanDocumentType {
  FACTURA
  COTIZACION
}

enum ScanProvider {
  PADDLEOCR
  TESSERACT
}

enum ScanStatus {
  PENDIENTE
  PROCESADO
  FALLIDO
  APROBADO
}

enum ScanFeedbackSource {
  UI_SINGLE
  UI_BULK
  API
}

// ============================================
// MÓDULO DE PROVEEDORES Y COMPRAS
// ============================================

enum EstadoCompra {
  BORRADOR
  REGISTRADA
  ANULADA
}

model Proveedor {
  id            String  @id @default(cuid())
  nombre        String
  nit           String? @unique
  telefono      String?
  direccion     String?
  email         String?
  contacto      String?
  ciudad        String?
  departamento  String?
  observaciones String? @db.Text
  activo        Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  compras Compra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
  @@index([empresaId])
  @@map("proveedores")
}

model Compra {
  id          String       @id @default(cuid())
  fechaCompra DateTime     @default(now())
  estado      EstadoCompra @default(BORRADOR)

  // Multi-sede (MVP): opcional para compatibilidad con registros antiguos
  sedeId  String?
  sedeRef Sede?   @relation("SedeCompras", fields: [sedeId], references: [id])

  // Proveedor (permitimos snapshot para reportes y para casos donde aún no exista un proveedor maestro)
  proveedorId        String?
  proveedor          Proveedor? @relation(fields: [proveedorId], references: [id])
  proveedorNombre    String
  proveedorTelefono  String?
  proveedorDireccion String?

  // Recepción
  recibidoPorId     String?
  recibidoPor       User?   @relation("CompraRecibidoPor", fields: [recibidoPorId], references: [id])
  recibidoPorNombre String?

  // Documentos
  numeroPedido  String?
  numeroOrden   String?
  numeroFactura String?

  // Totales (para reportes)
  subtotalSinIva Float @default(0)
  iva            Float @default(0)
  descuentoTotal Float @default(0)
  subtotalConIva Float @default(0)
  total          Float @default(0)

  // Contexto
  sede          String?
  observaciones String? @db.Text

  // Autorización
  autorizado     Boolean   @default(false)
  autorizadoAt   DateTime?
  autorizadoById String?
  autorizadoBy   User?     @relation("CompraAutorizadoPor", fields: [autorizadoById], references: [id])

  // Auditoría
  userId    String
  user      User    @relation("CompraCreadaPor", fields: [userId], references: [id], onDelete: Cascade)
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  items CompraItem[]

  pagos CompraPago[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId, fechaCompra], map: "idx_compras_sede_fecha")
  @@index([fechaCompra])
  @@index([estado])
  @@index([autorizado])
  @@index([empresaId])
  @@index([proveedorNombre])
  @@index([sedeId])
  @@map("compras")
}

model CompraPago {
  id String @id @default(cuid())

  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  fecha         DateTime         @default(now())
  monto         Float
  metodo        PosPaymentMethod @default(TRANSFER)
  referencia    String?
  observaciones String?          @db.Text

  // Soporte / recibo (archivo)
  soporteUrl          String?
  soporteStoredName   String?
  soporteOriginalName String?
  soporteMimeType     String?
  soporteSizeBytes    Int?

  sedeId  String?
  sedeRef Sede?   @relation("SedeCompraPagos", fields: [sedeId], references: [id])

  userId String
  user   User   @relation("CompraPagoCreadoPor", fields: [userId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([compraId])
  @@index([empresaId])
  @@index([sedeId])
  @@index([fecha])
  @@map("compra_pagos")
}

model CompraItem {
  id       String @id @default(cuid())
  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  descripcion    String
  cantidad       Float   @default(1)
  unidad         String?
  precioUnitario Float   @default(0)
  descuento      Float   @default(0)
  subtotalSinIva Float   @default(0)
  iva            Float   @default(0)
  total          Float   @default(0)
  observaciones  String? @db.Text

  orden Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([compraId])
  @@map("items_compra")
}

model DocumentScan {
  id       String           @id @default(cuid())
  tipo     ScanDocumentType
  provider ScanProvider
  status   ScanStatus       @default(PENDIENTE)

  // Multi-sede (MVP): opcional para compatibilidad con registros antiguos
  sedeId String?
  sede   Sede?   @relation("SedeScans", fields: [sedeId], references: [id])

  capturePercent Float @default(0)
  pageCount      Int   @default(1)

  approved     Boolean   @default(false)
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("ScanApprovedBy", fields: [approvedById], references: [id])

  userId String
  user   User   @relation("ScanCreatedBy", fields: [userId], references: [id], onDelete: Cascade)

  originalFileName String?
  storedFileName   String?
  mimeType         String
  fileUrl          String

  extractedText String? @db.Text
  extractedData Json?
  error         String? @db.Text

  fieldFeedback DocumentScanFieldFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status, approved])
  @@index([sedeId])
  @@map("document_scans")
}

model DocumentScanFieldFeedback {
  id     String       @id @default(cuid())
  scanId String
  scan   DocumentScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  // Quién confirmó/corrigió
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id])

  source    ScanFeedbackSource @default(UI_SINGLE)
  path      String
  confirmed Boolean            @default(true)

  previousValue Json?
  newValue      Json?

  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([userId])
  @@index([sedeId])
  @@index([path])
  @@map("document_scan_field_feedback")
}
