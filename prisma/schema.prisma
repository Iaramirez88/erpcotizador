  INGRESO
  EGRESO
  AJUSTE
  CIERRE
  APERTURA
}

enum AccountingVoucherStatus {
  DRAFT
  APPROVED
  POSTED
  VOIDED
}

enum PayrollEmployeeStatus {
  ACTIVE
  SUSPENDED
  RETIRED
}

enum PayrollContractType {
  INDEFINIDO
  FIJO
  OBRA_LABOR
  APRENDIZAJE
  PRESTACION
}

enum PayrollContractStatus {
  ACTIVE
  SUSPENDED
  FINALIZED
}

enum PayrollFrequency {
  QUINCENAL
  MENSUAL
