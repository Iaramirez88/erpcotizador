// ============================================
// MÓDULO DE EMPRESA
// ============================================

model Empresa {
  id        String  @id @default(cuid())
  // Código corto, visible y único para identificar el espacio de trabajo.
  // No es un token de acceso; se usa para referenciar/simplificar.
  workspaceCode String? @unique
  // Usuario dueño de facturación/planes. Solo este usuario debe ver la vista de Plan.
  // Se guarda como id (string) para evitar ambigüedad de múltiples relaciones User↔Empresa.
  planOwnerUserId String?
  nombre    String
  nit       String  @unique
  direccion String?
  telefono  String?
  whatsapp  String?
  email     String?
  logo      String?

  businessType String?
  onboardingStatus String @default("COMPLETED")
  onboardingCompletedAt DateTime?
  onboardingData Json @default("{}")
  dashboardConfig Json @default("{}")

  dianSettings Json @default("{}")

  // Código de acceso para permitir registro de usuarios en esta empresa.
  // Se guarda hasheado (bcrypt). Si es null, el registro es abierto.
  registrationCodeHash String? @db.Text

  registrationInvites RegistrationInvite[]

  planTier     PlanTier     @default(FULL)
  billingCycle BillingCycle @default(MONTHLY)

  // Vigencia del acceso por plan (Bold no expone suscripciones recurrentes públicas en docs;
  // se maneja por periodo pagado y renovaciones).
  planValidUntil DateTime?

  // Trial (para espacios personales / paywall)
  trialTier       PlanTier?
  trialStartedAt  DateTime?
  trialValidUntil DateTime?

  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripePriceId            String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   DateTime?
  stripeCancelAtPeriodEnd  Boolean   @default(false)

  billingInvoices BillingInvoice[]
  moduleOverrides EmpresaModuleOverride[]
  domainEntitlements DomainEntitlement[]
  capabilityEntitlements CapabilityEntitlement[]
  capabilityGrants UserCapabilityGrant[]
  permissionProfiles PermissionProfile[]
  permissionProfileAssignments PermissionProfileAssignment[]
  backupAccessGrants BackupAccessGrant[]
  backups EmpresaBackup[]

  inventoryMovements InventoryMovement[]

  // Bodegas / stock / POS
  warehouses  InventoryWarehouse[]
  posInvoices PosInvoice[]
  posReturns  PosReturn[]

  // DIAN (documentos electrónicos)
  dianDocuments DianElectronicDocument[]

  usuarios       User[]

  // Plantilla PDF de cotización compartida por empresa
  cotizacionTemplate EmpresaCotizacionTemplate?
  cotizacionTemplateVersions EmpresaCotizacionTemplateVersion[]
  globalAccesses UserGlobalAccess[]
  clientes       Cliente[]
  crmLeads       CrmLead[]
  crmOpportunities CrmOpportunity[]
  crmStageSettings CrmStageSetting[]
  crmContacts      CrmContact[]
  crmActivities  CrmActivity[]
  crmTasks       CrmTask[]
  crmTaskWorkspaces CrmTaskWorkspace[]
  crmTaskWorkspaceProjects CrmTaskWorkspaceProject[]
  crmTaskAssignments CrmTaskAssignment[]
  crmTaskHistories CrmTaskHistory[]
  crmChannelConnections CrmChannelConnection[]
  crmConversations     CrmConversation[]
  crmMessages          CrmMessage[]
  crmLeadCaptures      CrmLeadCapture[]
  internalChatThreads  InternalChatThread[]
  internalChatMessages InternalChatMessage[]
  productTypeOptions ProductTypeOption[]
  productCategoryOptions ProductCategoryOption[]
  productCustomFieldDefinitions ProductCustomFieldDefinition[]
  materiales     Material[]
  terminados     Terminado[]
  customProductRequests CustomProductRequest[]
  maquinas       Maquina[]

  remisiones Remision[]

  proveedores Proveedor[]
  compras     Compra[]
  compraPagos CompraPago[]

  sedes         Sede[]
  notifications Notification[]
  workspaceAccessRequests WorkspaceAccessRequest[]
  billingReminderLogs BillingReminderLog[]
  websiteServices WebsiteService[]
  websiteServiceModuleAccesses WebsiteServiceModuleAccess[]
  websiteServiceReminderSetting WebsiteServiceReminderSetting?
  websiteServiceReminderLogs WebsiteServiceReminderLog[]
  websiteServiceMessageTemplates WebsiteServiceMessageTemplate[]

  // Tarifario global de Litografía (misma configuración para todas las sedes)
  litografiaPrintProfiles LitografiaPrintProfile[]
  litografiaPaperRates    LitografiaPaperRate[]
  litografiaPaperRequests LitografiaPaperRequest[]
  litografiaFlyerRates    LitografiaFlyerRate[]
  litografiaProductos     LitografiaProducto[]
  litografiaFinishOptions LitografiaFinishOption[]
  litografiaPrintSizes    LitografiaPrintSize[]

  // Dropdowns configurables (por empresa)
  configDropdowns ConfigDropdown[]

  // Odontología
  odontologyAppointments OdontologyAppointment[]
  odontologyPatientProfiles OdontologyPatientProfile[]
  odontologyClinicalRecords OdontologyClinicalRecord[]
  odontologyTreatmentPlans OdontologyTreatmentPlan[]
  odontologyTreatmentPlanItems OdontologyTreatmentPlanItem[]
  
  inventoryTransfers InventoryTransfer[]

  // Contabilidad (configurable por empresa)
  accountingAccounts       AccountingAccount[]
  accountingCostCenters    AccountingCostCenter[]
  accountingRules          AccountingRule[]
  accountingPeriods        AccountingPeriod[]
  accountingVouchers       AccountingVoucher[]
  accountingJournalEntries AccountingJournalEntry[]
  decisionEngineSnapshots  DecisionEngineSnapshot[]
  treasuryBankAccounts     TreasuryBankAccount[]
  treasuryBankMovements    TreasuryBankMovement[]

  // Nómina
  payrollEmployees   PayrollEmployee[]
  payrollContracts   PayrollContract[]
  payrollPeriods     PayrollPeriod[]
  payrollPeriodItems PayrollPeriodItem[]
  payrollNovelties   PayrollNovelty[]
  payrollSettlements PayrollSettlement[]
  payrollPayslips    PayrollPayslip[]
  payrollAttendanceEntries PayrollAttendanceEntry[]
  payrollBenefitRequests PayrollBenefitRequest[]
  payrollEmployeeDocuments PayrollEmployeeDocument[]
  payrollOnboardingJourneys PayrollOnboardingJourney[]
  payrollEmployeeServiceCases PayrollEmployeeServiceCase[]
  payrollWhistleblowerCases PayrollWhistleblowerCase[]
  payrollRecruitmentCandidates PayrollRecruitmentCandidate[]
  payrollSurveyCampaigns PayrollSurveyCampaign[]
  payrollPerformanceReviews PayrollPerformanceReview[]
  payrollTrainingAssignments PayrollTrainingAssignment[]
  payrollBenefitOfferings PayrollBenefitOffering[]
  payrollOrgUnits    PayrollOrgUnit[]
  payrollPortalHighlights PayrollPortalHighlight[]
  payrollAccessProfiles PayrollAccessProfile[]
  payrollWorkflowTemplates PayrollWorkflowTemplate[]
  payrollPeopleReports PayrollPeopleReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("empresas")
}

model EmpresaModuleOverride {
  id        String    @id @default(cuid())
  empresaId String
  module    ModuleKey
  enabled   Boolean

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, module])
  @@index([empresaId])
  @@map("empresa_module_overrides")
}

model DomainEntitlement {
  id       String  @id @default(cuid())
  empresaId String
  domain   String
  enabled  Boolean @default(true)
