// ============================================
// SEDES / EQUIPOS / PERMISOS (MVP)
// ============================================

model Sede {
  id     String  @id @default(cuid())
  nombre String
  codigo String?

  // Configuración de cotizaciones por sede
  cotizacionesPricesIncludeIva Boolean @default(true)
  cotizacionesIvaPct           Float   @default(19)

  // Desperdicios (configuración por sede)
  desperdicioPctDefault Float @default(0)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  memberships   SedeMembership[]
  defaultUsers  User[] @relation("UserSedeDefault")
  teams         Team[]
  moduleAccess  UserModuleAccess[]
  permissionProfiles PermissionProfile[]
  permissionProfileAssignments PermissionProfileAssignment[]
  notifications Notification[]
  payrollEmployees PayrollEmployee[]
  payrollContracts PayrollContract[]
  payrollPeriods   PayrollPeriod[]
  payrollOrgUnits  PayrollOrgUnit[]
  decisionEngineSnapshots DecisionEngineSnapshot[]

  cotizaciones      Cotizacion[]                @relation("SedeCotizaciones")
  ordenes           OrdenTrabajo[]              @relation("SedeOrdenes")
  clientes          Cliente[]
  crmLeads          CrmLead[]
  crmOpportunities  CrmOpportunity[]
  crmContacts       CrmContact[]
  crmActivities     CrmActivity[]
  crmTasks          CrmTask[]
  crmTaskWorkspaces CrmTaskWorkspace[]
  crmTaskWorkspaceLinks CrmTaskWorkspaceSede[] @relation("CrmTaskWorkspaceSedeLink")
  crmChannelConnections CrmChannelConnection[]
  crmConversations     CrmConversation[]
  crmMessages          CrmMessage[]
  crmLeadCaptures      CrmLeadCapture[]
  compras           Compra[]                    @relation("SedeCompras")
  compraPagos       CompraPago[]                @relation("SedeCompraPagos")
  documentScans     DocumentScan[]              @relation("SedeScans")
  scanFieldFeedback DocumentScanFieldFeedback[]

  // Inventario / bodegas / POS
  inventoryMovements InventoryMovement[]
  warehouses         InventoryWarehouse[]
  posSequence        PosSequence?
