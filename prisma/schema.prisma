  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, domain, subdomain, action])
  @@index([empresaId, domain])
  @@map("capability_entitlements")
}

model BillingReminderLog {
  id String @id @default(cuid())

  empresaId String
