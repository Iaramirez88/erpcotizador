model CrmLead {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: SetNull)

  status CrmLeadStatus @default(NEW)
  source CrmLeadSource @default(OTRO)

  nombre        String
  empresaNombre String?
  documento     String?
  email         String?
  telefono      String?
  celular       String?
  direccion     String?
  ciudad        String?
  tags          String[] @default([])
  notes         String?  @db.Text

  ownerUserId String?
  ownerUser   User?   @relation("CrmLeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CrmLeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  convertedAt DateTime?
  convertedClienteId String?
  convertedCliente   Cliente? @relation("CrmLeadConvertedCliente", fields: [convertedClienteId], references: [id], onDelete: SetNull)

  lastActivityAt DateTime?

  opportunities CrmOpportunity[]
  contacts      CrmContact[]
  activities    CrmActivity[]
  tasks         CrmTask[]
  conversations CrmConversation[]
  captures      CrmLeadCapture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, status, createdAt])
  @@index([empresaId, sedeId, status])
  @@index([ownerUserId])
  @@index([convertedClienteId])
  @@map("crm_leads")
}

