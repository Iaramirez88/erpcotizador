// ============================================
// MÓDULO DE COTIZACIONES (FASE 1)
// ============================================

model Cotizacion {
  id          String   @id @default(cuid())
  numero      String // COT-2025-0001
  fecha       DateTime @default(now())
  validezDias Int      @default(15)

  // Multi-sede (MVP): opcional para compatibilidad con registros antiguos
  sedeId String?
  sede   Sede?   @relation("SedeCotizaciones", fields: [sedeId], references: [id])

  // Tracking de envíos
  emailSentCount     Int       @default(0)
  whatsappSentCount  Int       @default(0)
  lastEmailSentAt    DateTime?
  lastWhatsappSentAt DateTime?

  // Trazabilidad de cambios (ediciones)
  editCount Int @default(0)
  // Ediciones realizadas después de estar APROBADA (cambios post-aprobación)
  postApprovalEditCount Int @default(0)

  // Marca de "Venta Realizada" (aprobación final del cliente)
  ventaRealizadaAt DateTime?

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String
  vendedor   User   @relation("CotizacionVendedor", fields: [vendedorId], references: [id])

  assignedToUserId String?
  assignedTo       User?   @relation("CotizacionAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedAt       DateTime?

  items ItemCotizacion[]

  subtotal  Float @default(0)
  descuento Float @default(0)
  iva       Float @default(0)
  total     Float @default(0)

  // Condiciones / pagos
  garantia          String?  @db.Text
  paymentMethods    String[] @default([])
  boldPaymentLinkId String?  @unique
  boldCheckoutUrl   String?

  estado        EstadoCotizacion @default(BORRADOR)
  observaciones String?          @db.Text

  // Conversión a orden
  orden OrdenTrabajo? @relation("CotizacionOrden")
  posInvoice PosInvoice?
  crmOpportunity CrmOpportunity?

  // Auditoría
  auditEvents CotizacionAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, createdAt], map: "idx_cotizaciones_estado_created")
  @@index([sedeId, createdAt], map: "idx_cotizaciones_sede_created")
  @@index([sedeId, estado], map: "idx_cotizaciones_sede_estado")
  @@index([sedeId])
  @@index([assignedToUserId])
  @@unique([sedeId, numero], map: "uq_cotizaciones_sede_numero")
  @@map("cotizaciones")
}

enum CotizacionAuditAction {
  CREATED
  UPDATED
  APPROVED
  SENT
  SALE_REALIZED_SET
  SALE_REALIZED_UNSET
}

enum CotizacionAuditEffect {
  NONE
  DEBIT
  CREDIT
}

model CotizacionAuditEvent {
  id String @id @default(cuid())

  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  action CotizacionAuditAction
  effect CotizacionAuditEffect @default(NONE)

  // Nota libre (opcional) para justificar el cambio
  note String? @db.Text

  // Snapshot mínimo (para trazabilidad sin recalcular)
  before Json?
  after  Json?

  performedById String
  performedBy   User   @relation("CotizacionAuditPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  // Si alguien solicitó el cambio y otro lo ejecutó.
  requestedById String?
  requestedBy   User?  @relation("CotizacionAuditRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([cotizacionId, createdAt], map: "idx_cot_audit_cot_created")
  @@index([action, createdAt], map: "idx_cot_audit_action_created")
  @@map("cotizacion_audit_events")
}

model ItemCotizacion {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  descripcion String
  cantidad    Float
  unidad      String // m2, unidad, ml

  // Dimensiones
  ancho Float?
  alto  Float?
  area  Float? // Calculado automáticamente

  // Desperdicio (por item)
  desperdicioPct Float @default(0)

  // Materiales
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  // Acabados
  laminado    Boolean @default(false)
  troquelado  Boolean @default(false)
  instalacion Boolean @default(false)

  // Costos
  costoMaterial    Float @default(0)
  costoImpresion   Float @default(0)
  costoAcabados    Float @default(0)
  costoInstalacion Float @default(0)
  precioUnitario   Float
  subtotal         Float

  // Nota del item (y también meta embebida del cotizador Litografía: "LITOGRAFIA_META:...")
  observaciones String? @db.Text

  orden Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terminados ItemCotizacionTerminado[]

  @@index([cotizacionId], map: "idx_items_cotizacion_cot")
  @@map("items_cotizacion")
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
  VENCIDA
  CONVERTIDA
}

// ============================================
// MÓDULO DE MATERIALES Y PRECIOS
// ============================================

model Material {
  id        String       @id @default(cuid())
  // Identificador/código opcional asignado por el cliente (p.ej. sistema de caja)
  externalId String?
  nombre    String
  tipo      TipoMaterial
  tipoNombre String?
  categoria String?
  extraFields Json @default("{}")

  // Productos creados vía flujo “personalizado” (requiere aprobación admin)
  isCustom Boolean @default(false)
  requiresWorkOrder Boolean @default(false)

  // Scope de productos personalizados: solo visibles para el usuario y sede que lo creó
  customOwnerUserId String?
  customSedeId      String?

  // Imagen del producto/servicio (URL pública o ruta absoluta/relativa)
  imagenUrl String?

  // Especificaciones
  ancho   Float? // En cm
  largo   Float? // En cm o metros
  espesor Float? // En mm
  color   String?

  // Precios
  precioM2     Float?
  precioMetro  Float?
  precioUnidad Float?
  precioCompra Float?

  remisionItems RemisionItem[]

  // Stock
  stockActual  Float  @default(0)
  stockMinimo  Float  @default(0)
  unidadMedida String // m2, ml, unidad

  proveedor     String?
  observaciones String? @db.Text

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  items ItemCotizacion[]

  // Terminados permitidos por producto (si existe al menos 1, se restringe el listado en el cotizador)
  allowedTerminados MaterialAllowedTerminado[]

  customProductRequests CustomProductRequest[]

  sedeWastes SedeMaterialWaste[]

  quantityDiscounts MaterialQuantityDiscount[]

  inventoryMovements InventoryMovement[]
  stocks             InventoryStock[]
  inventoryTransfers InventoryTransfer[]

  posInvoiceItems PosInvoiceItem[]
  posReturnItems  PosReturnItem[]

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, externalId], map: "uq_materiales_empresa_external_id")
  @@index([empresaId, externalId], map: "idx_materiales_empresa_external_id")
  @@index([empresaId, activo], map: "idx_materiales_empresa_activo")
  @@index([empresaId, isCustom], map: "idx_materiales_empresa_is_custom")
  @@index([empresaId, customOwnerUserId, customSedeId], map: "idx_materiales_empresa_custom_scope")
  @@map("materiales")
}

model ProductTypeOption {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre   String
  baseTipo TipoMaterial @default(OTRO)
  activo   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre], map: "uq_product_type_options_empresa_nombre")
  @@index([empresaId, activo], map: "idx_product_type_options_empresa_activo")
  @@map("product_type_options")
}

model ProductCategoryOption {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre   String
  activo   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre], map: "uq_product_category_options_empresa_nombre")
  @@index([empresaId, activo], map: "idx_product_category_options_empresa_activo")
  @@map("product_category_options")
}

model ProductCustomFieldDefinition {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  key       String
  label     String
  fieldType ProductCustomFieldType @default(TEXT)
  helpText  String? @db.Text
  required  Boolean @default(false)
  activo    Boolean @default(true)
  optionsJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, key], map: "uq_product_custom_field_defs_empresa_key")
  @@index([empresaId, activo], map: "idx_product_custom_field_defs_empresa_activo")
  @@map("product_custom_field_definitions")
}

model MaterialAllowedTerminado {
  id String @id @default(cuid())

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  terminadoId String
  terminado   Terminado @relation(fields: [terminadoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([materialId, terminadoId])
  @@index([terminadoId])
  @@index([materialId])
  @@map("material_allowed_terminados")
}

enum CustomProductRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomProductKind {
  METRAJE
  FISICO
}

model CustomProductRequest {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdByUser   User @relation("CustomProductRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  // Sede desde donde se solicitó (scope del producto)
  sedeId String

  approvedByUserId String?
  approvedByUser   User? @relation("CustomProductRequestApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  status       CustomProductRequestStatus @default(PENDING)
  decisionNote String? @db.Text

  // Datos solicitados
  externalId String?
  nombre     String
  kind       CustomProductKind

  // Tipo del material solicitado
  tipo TipoMaterial @default(OTRO)

  unidadMedida String
  categoria   String?
  proveedor   String?
  observaciones String? @db.Text

  ancho Float?
  largo Float?

  precioM2     Float?
  precioMetro  Float?
  precioUnidad Float?

  // Si se aprueba, queda vinculado al material creado
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  terminados CustomProductRequestTerminado[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, status])
  @@index([empresaId, createdAt])
  @@index([empresaId, sedeId, status])
  @@map("custom_product_requests")
}

model CustomProductRequestTerminado {
  id String @id @default(cuid())

  requestId String
  request   CustomProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  terminadoId String
  terminado   Terminado @relation(fields: [terminadoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([requestId, terminadoId])
  @@index([terminadoId])
  @@index([requestId])
  @@map("custom_product_request_terminados")
}

model SedeMaterialWaste {
  id         String @id @default(cuid())
  sedeId     String
  materialId String

  desperdicioPct Float @default(0)

  sede     Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, materialId])
  @@index([materialId])
  @@index([sedeId])
  @@map("sede_material_waste")
}

model MaterialQuantityDiscount {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  // Descuento aplicable cuando cantidad >= minQty
  minQty      Float
  discountPct Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, minQty])
  @@index([materialId])
  @@map("material_quantity_discounts")
}

// ============================================
// TERMINADOS (catálogo de acabados)
// ============================================

model Terminado {
  id String @id @default(cuid())

  nombre           String
  unidadAplicacion String // m2, ml, unidad
  precioUnitario   Float  @default(0)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  items ItemCotizacionTerminado[]

  allowedInMaterials MaterialAllowedTerminado[]
  customRequests CustomProductRequestTerminado[]

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("terminados")
}

model ItemCotizacionTerminado {
  id String @id @default(cuid())

  itemCotizacionId String
  itemCotizacion   ItemCotizacion @relation(fields: [itemCotizacionId], references: [id], onDelete: Cascade)

  terminadoId String
  terminado   Terminado @relation(fields: [terminadoId], references: [id], onDelete: Cascade)

  unidadAplicacion String
  baseCantidad     Float  @default(0)
  precioUnitario   Float  @default(0)
  costoTotal       Float  @default(0)

  createdAt DateTime @default(now())

  @@unique([itemCotizacionId, terminadoId])
  @@index([terminadoId])
  @@index([itemCotizacionId])
  @@map("item_cotizacion_terminados")
}

enum TipoMaterial {
  VINILO
  LONA
  BANNER
  MICROPERFORADO
  ONE_WAY
  ADHESIVO
  PAPEL
  CARTULINA
  FOAM
  ACRILICO
  PVC
  OTRO
}

enum ProductCustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  BOOLEAN
  DATE
}

// ============================================
// MÓDULO DE ÓRDENES DE TRABAJO (FASE 2)
// ============================================

model OrdenTrabajo {
  id           String    @id @default(cuid())
  numero       String    @unique // OT-2025-0001
  fecha        DateTime  @default(now())
  fechaInicio  DateTime?
  fechaEntrega DateTime?

  // Multi-sede (MVP): opcional para compatibilidad con registros antiguos
  sedeId String?
  sede   Sede?   @relation("SedeOrdenes", fields: [sedeId], references: [id])

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String
  vendedor   User   @relation("OrdenVendedor", fields: [vendedorId], references: [id])

  assignedToUserId String?
  assignedTo       User?   @relation("OrdenAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?

  sourceType String? @db.VarChar(32)
  sourceId   String?

  // Referencia a cotización
  cotizacionId String?     @unique
  cotizacion   Cotizacion? @relation("CotizacionOrden", fields: [cotizacionId], references: [id])

  posInvoiceId String?     @unique
  posInvoice   PosInvoice? @relation("PosInvoiceOrden", fields: [posInvoiceId], references: [id], onDelete: SetNull)

  // Valores financieros
  subtotal  Float @default(0)
  descuento Float @default(0)
  iva       Float @default(0)
  total     Float @default(0)

  itemsSnapshot Json?

  // Proceso de producción
  etapas EtapaProduccion[]

  estado    EstadoOrden @default(PENDIENTE)
  prioridad Prioridad   @default(NORMAL)

  areaResponsable String? @db.VarChar(120)
  observaciones  String? @db.Text
  archivosDiseno Json? // URLs de archivos
  tareaSeguimiento CrmTask? @relation("OrdenTrabajoTask")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, createdAt], map: "idx_ordenes_estado_created")
  @@index([sedeId, createdAt], map: "idx_ordenes_sede_created")
  @@index([sedeId, estado], map: "idx_ordenes_sede_estado")
  @@index([sedeId])
  @@index([assignedToUserId])
  @@index([sourceType, sourceId], map: "idx_ordenes_source")
  @@map("ordenes_trabajo")
}

model EtapaProduccion {
  id      String       @id @default(cuid())
  ordenId String
  orden   OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  nombre    String // Diseño, Preprensa, Impresión, Acabados, Entrega
  secuencia Int // Orden de la etapa (1, 2, 3, etc.)

  maquinaId String?
  maquina   Maquina? @relation(fields: [maquinaId], references: [id])

  estado EstadoEtapa @default(PENDIENTE)

  fechaInicio    DateTime?
  fechaFin       DateTime?
  tiempoEstimado Int? // En minutos
  tiempoReal     Int? // En minutos

  responsable   String?
  observaciones String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("etapas_produccion")
}

model Maquina {
  id     String  @id @default(cuid())
  nombre String
  tipo   String // Plotter, Impresora, Laminadora, etc.
  marca  String?
  modelo String?

  anchoMax  Float? // En cm
  velocidad Float? // m2/hora

  estado EstadoMaquina @default(DISPONIBLE)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  etapas EtapaProduccion[]

  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maquinas")
}

enum EstadoOrden {
  PENDIENTE
  RECIBIDO
  COTIZADO
  APROBADO
  EN_DISENO
  EN_CORRECCION
  APROBADO_PRODUCCION
  EN_IMPRESION
  EN_PRODUCCION
  EN_ACONDICIONAMIENTO
  EN_ACABADOS
  EN_ENTREGA
  LISTA_ENTREGA
  ENTREGADA
  FACTURADO
  CERRADO
  CANCELADA
}

enum EstadoEtapa {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  DETENIDA
}

enum EstadoMaquina {
  DISPONIBLE
  EN_USO
  MANTENIMIENTO
  FUERA_SERVICIO
}

enum Prioridad {
  BAJA
  NORMAL
  ALTA
  URGENTE
}

// ============================================
// MÓDULO DE ESCANEO (IA/OCR) - FACTURAS/COTIZACIONES
// ============================================

enum ScanDocumentType {
  FACTURA
  COTIZACION
}

enum ScanProvider {
  PADDLEOCR
  TESSERACT
}

enum ScanStatus {
  PENDIENTE
  PROCESADO
  FALLIDO
  APROBADO
}

enum ScanFeedbackSource {
  UI_SINGLE
  UI_BULK
  API
}

// ============================================
// MÓDULO DE PROVEEDORES Y COMPRAS
// ============================================

enum EstadoCompra {
  BORRADOR
  REGISTRADA
  ANULADA
}

model Proveedor {
  id            String  @id @default(cuid())
  nombre        String
  nit           String? @unique
  telefono      String?
  direccion     String?
  email         String?
  contacto      String?
  ciudad        String?
  departamento  String?
  observaciones String? @db.Text
  activo        Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  compras Compra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
  @@index([empresaId])
  @@map("proveedores")
}

model Compra {
  id          String       @id @default(cuid())
  fechaCompra DateTime     @default(now())
  estado      EstadoCompra @default(BORRADOR)
  // Multi-sede (MVP): opcional para compatibilidad con registros antiguos
  sedeId  String?
  sedeRef Sede?   @relation("SedeCompras", fields: [sedeId], references: [id])

  // Proveedor (permitimos snapshot para reportes y para casos donde aún no exista un proveedor maestro)
  proveedorId        String?
  proveedor          Proveedor? @relation(fields: [proveedorId], references: [id])
  proveedorNombre    String
  proveedorTelefono  String?
  proveedorDireccion String?

  // Recepción
  recibidoPorId     String?
  recibidoPor       User?   @relation("CompraRecibidoPor", fields: [recibidoPorId], references: [id])
  recibidoPorNombre String?

  // Documentos
  numeroPedido  String?
  numeroOrden   String?
  numeroFactura String?

  // Totales (para reportes)
  subtotalSinIva Float @default(0)
  iva            Float @default(0)
  descuentoTotal Float @default(0)
  subtotalConIva Float @default(0)
  total          Float @default(0)

  // Contexto
  sede          String?
  observaciones String? @db.Text

  // Autorización
  autorizado     Boolean   @default(false)
  autorizadoAt   DateTime?
  autorizadoById String?
  autorizadoBy   User?     @relation("CompraAutorizadoPor", fields: [autorizadoById], references: [id])

  // Auditoría
  userId    String
  user      User    @relation("CompraCreadaPor", fields: [userId], references: [id], onDelete: Cascade)
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  items CompraItem[]

  pagos CompraPago[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId, fechaCompra], map: "idx_compras_sede_fecha")
  @@index([fechaCompra])
  @@index([estado])
  @@index([autorizado])
  @@index([empresaId])
  @@index([proveedorNombre])
  @@index([sedeId])
  @@map("compras")
}

model CompraPago {
  id String @id @default(cuid())

  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  fecha         DateTime         @default(now())
  monto         Float
  metodo        PosPaymentMethod @default(TRANSFER)
  referencia    String?
  observaciones String?          @db.Text

  // Soporte / recibo (archivo)
  soporteUrl          String?
  soporteStoredName   String?
  soporteOriginalName String?
  soporteMimeType     String?
  soporteSizeBytes    Int?

  sedeId  String?
  sedeRef Sede?   @relation("SedeCompraPagos", fields: [sedeId], references: [id])

  userId String
  user   User   @relation("CompraPagoCreadoPor", fields: [userId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([compraId])
  @@index([empresaId])
  @@index([sedeId])
  @@index([fecha])
  @@map("compra_pagos")
}

model CompraItem {
  id       String @id @default(cuid())
  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  descripcion    String
  cantidad       Float   @default(1)
  unidad         String?
  precioUnitario Float   @default(0)
  descuento      Float   @default(0)
  subtotalSinIva Float   @default(0)
  iva            Float   @default(0)
  total          Float   @default(0)
  observaciones  String? @db.Text

  orden Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([compraId])
  @@map("items_compra")
}

model DocumentScan {
  id       String           @id @default(cuid())
  tipo     ScanDocumentType
  provider ScanProvider
  status   ScanStatus       @default(PENDIENTE)

  // Multi-sede (MVP): opcional para compatibilidad con registros antiguos
  sedeId String?
  sede   Sede?   @relation("SedeScans", fields: [sedeId], references: [id])

  capturePercent Float @default(0)
  pageCount      Int   @default(1)

  approved     Boolean   @default(false)
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("ScanApprovedBy", fields: [approvedById], references: [id])

  userId String
  user   User   @relation("ScanCreatedBy", fields: [userId], references: [id], onDelete: Cascade)

  originalFileName String?
  storedFileName   String?
  mimeType         String
  fileUrl          String

  extractedText String? @db.Text
  extractedData Json?
  error         String? @db.Text

  fieldFeedback DocumentScanFieldFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status, approved])
  @@index([sedeId])
  @@map("document_scans")
}

model DocumentScanFieldFeedback {
  id     String       @id @default(cuid())
  scanId String
  scan   DocumentScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  // Quién confirmó/corrigió
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id])

  source    ScanFeedbackSource @default(UI_SINGLE)
  path      String
  confirmed Boolean            @default(true)

  previousValue Json?
  newValue      Json?

  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([userId])
  @@index([sedeId])
  @@index([path])
  @@map("document_scan_field_feedback")
}

