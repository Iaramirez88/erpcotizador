// Schema de Base de Datos - SGDigital Cotizador Inteligente
// Generado: Diciembre 2025

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// MÓDULO DE AUTENTICACIÓN Y USUARIOS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  empresaId     String?
  empresa       Empresa?  @relation(fields: [empresaId], references: [id])

  // Datos de perfil (para PDFs / cotización)
  telefono      String?
  cargo         String?
  sedeDefaultId String?
  sedeDefault   Sede?     @relation("UserSedeDefault", fields: [sedeDefaultId], references: [id], onDelete: SetNull)

  lastLoginAt   DateTime?

  // Preferencias de UI (menú, reportes)
  uiPreference UiPreference?

  // Plantilla PDF de cotización (configurable por usuario)
  cotizacionTemplate CotizacionTemplate?

  // Historial de versiones de plantilla (por usuario)
  cotizacionTemplateVersions CotizacionTemplateVersion[]

  // Versiones de plantilla por empresa creadas por este usuario
  empresaCotizacionTemplateVersionsCreated EmpresaCotizacionTemplateVersion[] @relation("EmpresaCotizacionTemplateVersionCreatedBy")
  
  // Plantilla PDF de remisión (configurable por usuario)
  remisionTemplate RemisionTemplate?

  // Plantilla PDF de orden de compra (configurable por usuario)
  ordenCompraTemplate OrdenCompraTemplate?

  // Plantilla PDF de factura POS (configurable por usuario)
  posInvoiceTemplate PosInvoiceTemplate?

  // Relaciones NextAuth
  accounts Account[]
  sessions Session[]

  // Relaciones del negocio
  cotizaciones Cotizacion[] @relation("CotizacionVendedor")
  cotizacionesAsignadas Cotizacion[] @relation("CotizacionAssignedTo")
  ordenes      OrdenTrabajo[] @relation("OrdenVendedor")
  ordenesAsignadas OrdenTrabajo[] @relation("OrdenAssignedTo")
  crmLeadsOwned CrmLead[] @relation("CrmLeadOwner")
  crmLeadsCreated CrmLead[] @relation("CrmLeadCreatedBy")
  crmOpportunitiesAssigned CrmOpportunity[] @relation("CrmOpportunityAssignedTo")
  crmOpportunitiesCreated CrmOpportunity[] @relation("CrmOpportunityCreatedBy")
  crmActivitiesCreated CrmActivity[] @relation("CrmActivityCreatedBy")
  crmContactsCreated CrmContact[] @relation("CrmContactCreatedBy")
  crmTasksAssigned CrmTask[] @relation("CrmTaskAssignedTo")
  crmTasksCreated CrmTask[] @relation("CrmTaskCreatedBy")
  crmTaskWorkspacesCreated CrmTaskWorkspace[] @relation("CrmTaskWorkspaceCreatedBy")
  crmTaskWorkspacesOwned CrmTaskWorkspace[] @relation("CrmTaskWorkspaceOwner")
  crmTaskWorkspaceProjectsCreated CrmTaskWorkspaceProject[] @relation("CrmTaskWorkspaceProjectCreatedBy")
  crmTaskWorkspaceMemberships CrmTaskWorkspaceMember[] @relation("CrmTaskWorkspaceMemberUser")
  crmTaskAssignments CrmTaskAssignment[] @relation("CrmTaskAssignmentUser")
  crmTaskHistoriesActed CrmTaskHistory[] @relation("CrmTaskHistoryActor")
  crmChannelConnectionsCreated CrmChannelConnection[] @relation("CrmChannelConnectionCreatedBy")
  crmConversationsAssigned CrmConversation[] @relation("CrmConversationAssignedTo")
  crmMessagesSent CrmMessage[] @relation("CrmMessageSentBy")
  internalChatParticipants InternalChatParticipant[]
  internalChatMessagesSent InternalChatMessage[] @relation("InternalChatMessageSentBy")
  internalChatsCreated InternalChatThread[] @relation("InternalChatThreadCreatedBy")

  // Auditoría de cotizaciones
  cotizacionAuditEventsPerformed CotizacionAuditEvent[] @relation("CotizacionAuditPerformedBy")
  cotizacionAuditEventsRequested CotizacionAuditEvent[] @relation("CotizacionAuditRequestedBy")

  // Escaneo de documentos (IA/OCR)
  documentScans     DocumentScan[]              @relation("ScanCreatedBy")
  approvedScans     DocumentScan[]              @relation("ScanApprovedBy")
  scanFieldFeedback DocumentScanFieldFeedback[]

  // Compras
  comprasCreadas     Compra[]     @relation("CompraCreadaPor")
  comprasAutorizadas Compra[]     @relation("CompraAutorizadoPor")
  comprasRecibidas   Compra[]     @relation("CompraRecibidoPor")
  compraPagosCreados CompraPago[] @relation("CompraPagoCreadoPor")

  // Seguridad: verificación de email y restablecimiento de contraseña
  emailVerificationCodes EmailVerificationCode[]
  passwordResetTokens    PasswordResetToken[]

  // RBAC por sede / equipos
  sedeMemberships SedeMembership[]
  teamMemberships TeamMember[]
  moduleAccess    UserModuleAccess[]
  globalAccess    UserGlobalAccess?
  capabilityGrants UserCapabilityGrant[] @relation("UserCapabilityGrantSubject")
  capabilityGrantsAuthored UserCapabilityGrant[] @relation("UserCapabilityGrantGrantedBy")
  permissionProfilesCreated PermissionProfile[] @relation("PermissionProfileCreatedBy")
  permissionProfileAssignments PermissionProfileAssignment[] @relation("PermissionProfileAssignmentUser")
  permissionProfileAssignmentsApplied PermissionProfileAssignment[] @relation("PermissionProfileAssignmentAppliedBy")
  backupAccessGrants BackupAccessGrant[] @relation("BackupAccessGrantUser")
  empresaBackupsCreated EmpresaBackup[] @relation("EmpresaBackupCreatedBy")
  empresaBackupsImported EmpresaBackup[] @relation("EmpresaBackupImportedBy")

  // Notificaciones
  notifications Notification[]
  webPushSubscriptions WebPushSubscription[]

  litografiaPaperRequestsCreated  LitografiaPaperRequest[] @relation("LitografiaPaperRequestCreatedBy")
  litografiaPaperRequestsApproved LitografiaPaperRequest[] @relation("LitografiaPaperRequestApprovedBy")

  // Solicitudes de acceso por código WS-...
  workspaceAccessRequestsCreated WorkspaceAccessRequest[] @relation("WorkspaceAccessRequestRequester")
  workspaceAccessRequestsDecided WorkspaceAccessRequest[] @relation("WorkspaceAccessRequestDecidedBy")

  // Videos de Ayuda
  helpVideos HelpVideo[]

  // Servicios web privados
  websiteServicesCreated WebsiteService[] @relation("WebsiteServiceCreatedBy")
  websiteServicesUpdated WebsiteService[] @relation("WebsiteServiceUpdatedBy")
  websiteServiceModuleAccesses WebsiteServiceModuleAccess[]

  // Inventario
  inventoryMovements InventoryMovement[]

  // POS (facturación interna)
  posInvoicesCreated PosInvoice[] @relation("PosInvoiceCreatedBy")
  posInvoiceAuditEventsPerformed PosInvoiceAuditEvent[] @relation("PosInvoiceAuditPerformedBy")
  posReturnsCreated  PosReturn[]  @relation("PosReturnCreatedBy")

  // DIAN (documentos electrónicos)
  dianDocumentsCreated DianElectronicDocument[] @relation("DianDocCreatedBy")

  // Remisiones
  remisionesCreadas Remision[] @relation("RemisionCreatedBy")
  remisionesAsignadas Remision[] @relation("RemisionAssignedTo")
  
  // Traslados de inventario
  transfersCreated   InventoryTransfer[] @relation("TransferCreated")
  transfersCompleted InventoryTransfer[] @relation("TransferCompleted")

  // Contabilidad
  accountingJournalEntriesCreated AccountingJournalEntry[] @relation("AccountingJournalEntryCreatedBy")
  accountingPeriodsCreated       AccountingPeriod[]       @relation("AccountingPeriodCreatedBy")
  accountingVouchersCreated      AccountingVoucher[]      @relation("AccountingVoucherCreatedBy")
  accountingVouchersApproved     AccountingVoucher[]      @relation("AccountingVoucherApprovedBy")

  // Nómina
  payrollEmployeeProfile   PayrollEmployee?   @relation("PayrollEmployeeUser")
  payrollNoveltiesCreated  PayrollNovelty[]   @relation("PayrollNoveltyCreatedBy")
  payrollNoveltiesApproved PayrollNovelty[]   @relation("PayrollNoveltyApprovedBy")
  payrollSettlementsCreated PayrollSettlement[] @relation("PayrollSettlementCreatedBy")
  payrollAttendanceEntriesCreated PayrollAttendanceEntry[] @relation("PayrollAttendanceCreatedBy")
  payrollAttendanceEntriesApproved PayrollAttendanceEntry[] @relation("PayrollAttendanceApprovedBy")
  payrollBenefitRequestsCreated PayrollBenefitRequest[] @relation("PayrollBenefitCreatedBy")
  payrollBenefitRequestsApproved PayrollBenefitRequest[] @relation("PayrollBenefitApprovedBy")
  payrollDocumentsSigned PayrollEmployeeDocument[] @relation("PayrollDocumentSignedBy")
  payrollOnboardingJourneysOwned PayrollOnboardingJourney[] @relation("PayrollOnboardingOwner")
  payrollServiceCasesAssigned PayrollEmployeeServiceCase[] @relation("PayrollServiceAssignedTo")
  payrollServiceCasesResolved PayrollEmployeeServiceCase[] @relation("PayrollServiceResolvedBy")
  payrollWhistleblowerCasesAssigned PayrollWhistleblowerCase[] @relation("PayrollWhistleAssignedTo")
  payrollWhistleblowerCasesResolved PayrollWhistleblowerCase[] @relation("PayrollWhistleResolvedBy")
  payrollRecruitmentCandidatesOwned PayrollRecruitmentCandidate[] @relation("PayrollRecruitmentOwner")
  payrollSurveyCampaignsOwned PayrollSurveyCampaign[] @relation("PayrollSurveyOwner")
  payrollPerformanceReviewsOwned PayrollPerformanceReview[] @relation("PayrollPerformanceOwner")
  payrollTrainingAssignmentsOwned PayrollTrainingAssignment[] @relation("PayrollTrainingOwner")
  payrollAccessProfiles PayrollAccessProfile[]
  payrollWorkflowTemplatesOwned PayrollWorkflowTemplate[] @relation("PayrollWorkflowOwner")
  payrollPeopleReportsOwned PayrollPeopleReport[] @relation("PayrollPeopleReportOwner")

  // Productos personalizados (solicitudes)
  customProductRequestsCreated  CustomProductRequest[] @relation("CustomProductRequestCreatedBy")
  customProductRequestsApproved CustomProductRequest[] @relation("CustomProductRequestApprovedBy")

  // Odontología
  odontologyAppointmentsAssigned OdontologyAppointment[] @relation("OdontologyAppointmentAssignedDentist")
  odontologyAppointmentsCreated OdontologyAppointment[] @relation("OdontologyAppointmentCreatedBy")
  odontologyClinicalRecordsCreated OdontologyClinicalRecord[] @relation("OdontologyClinicalRecordCreatedBy")
  odontologyTreatmentPlansCreated OdontologyTreatmentPlan[] @relation("OdontologyTreatmentPlanCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model EmailVerificationCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  codeHash  String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@map("email_verification_codes")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@map("password_reset_tokens")
}

model RegistrationInvite {
  id       String @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  email    String
  codeHash String @db.Text

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([empresaId, email])
  @@map("registration_invites")
}

model CotizacionTemplate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  settings Json @default("{}")
  defaultSettings Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cotizacion_templates")
}

model CotizacionTemplateVersion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  settings Json @default("{}")
  defaultSettings Json @default("{}")

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("cotizacion_template_versions")
}

model EmpresaCotizacionTemplate {
  id       String @id @default(cuid())
  empresaId String @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  settings Json @default("{}")
  defaultSettings Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("empresa_cotizacion_templates")
}

model EmpresaCotizacionTemplateVersion {
  id        String @id @default(cuid())
  empresaId  String
  empresa    Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User?   @relation("EmpresaCotizacionTemplateVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  settings Json @default("{}")
  defaultSettings Json @default("{}")

  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
  @@map("empresa_cotizacion_template_versions")
}

model RemisionTemplate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  settings Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("remision_templates")
}

model OrdenCompraTemplate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  settings Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orden_compra_templates")
}

model PosInvoiceTemplate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  settings Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pos_invoice_templates")
}

model UiPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nav      Json @default("{}")
  report   Json @default("{}")
  tutorial Json @default("{}")

  // Idioma preferido para la UI (ES/EN)
  language String @default("es")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ui_preferences")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

