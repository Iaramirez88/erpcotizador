model AccountingAccount {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  code String
  name String

  type          AccountingAccountType
  normalBalance AccountingNormalBalance

  parentId String?
  parent   AccountingAccount?  @relation("AccountingAccountParent", fields: [parentId], references: [id], onDelete: SetNull)
  children AccountingAccount[] @relation("AccountingAccountParent")

  ruleLines      AccountingRuleLine[]
  journalLines   AccountingJournalLine[]
  voucherLines   AccountingVoucherLine[]
  bankAccounts   TreasuryBankAccount[]

  // Cuenta auxiliar (posteable). Si es false, actúa como agrupadora.
  isPosting Boolean @default(true)
  isActive  Boolean @default(true)

  metadata Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, code])
  @@index([empresaId, type])
  @@index([empresaId, parentId])
  @@map("accounting_accounts")
}

model AccountingCostCenter {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  code String
  name String

  ruleLines    AccountingRuleLine[]
  journalLines AccountingJournalLine[]
  voucherLines AccountingVoucherLine[]
  payrollEmployees   PayrollEmployee[]
  payrollContracts   PayrollContract[]
  payrollPeriodItems PayrollPeriodItem[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, code])
  @@index([empresaId])
  @@map("accounting_cost_centers")
}

model AccountingRule {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  eventType    AccountingEventType
  documentType String?

  name        String
  description String?
  priority    Int     @default(100)
  isActive    Boolean @default(true)

  // Espacio para condiciones por empresa (ej: método de pago, prefijos, etc.)
  conditions Json @default("{}")

  lines AccountingRuleLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, eventType, priority])
  @@index([empresaId, isActive])
  @@map("accounting_rules")
}

model AccountingRuleLine {
  id     String @id @default(cuid())
  ruleId String
  rule   AccountingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  order Int @default(0)

  side      AccountingPostingSide
  accountId String
  account   AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  costCenterId String?
  costCenter   AccountingCostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  amountKey  AccountingAmountKey
  multiplier Float @default(1)

  memoTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleId, order])
  @@index([accountId])
  @@map("accounting_rule_lines")
}

model AccountingJournalEntry {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  status AccountingEntryStatus @default(POSTED)

  // Fuente
  eventType      AccountingEventType
  referenceType  String
  referenceId    String
  referenceExtra Json @default("{}")

  date        DateTime
  description String
  currency    String @default("COP")

  totalDebit  Float @default(0)
  totalCredit Float @default(0)

  createdById String?
  createdBy   User? @relation("AccountingJournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lines AccountingJournalLine[]

  voucher AccountingVoucher?

  treasuryMovements TreasuryBankMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, referenceType, referenceId])
  @@index([empresaId, date])
  @@index([empresaId, eventType, date])
  @@map("accounting_journal_entries")
}

model AccountingJournalLine {
  id      String @id @default(cuid())
  entryId String
  entry   AccountingJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String
  account   AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  costCenterId String?
  costCenter   AccountingCostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  debit  Float @default(0)
  credit Float @default(0)
  memo   String?

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([accountId])
  @@index([costCenterId])
  @@map("accounting_journal_lines")
}

model AccountingPeriod {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  code   String
  label  String
  status AccountingPeriodStatus @default(OPEN)

  startsAt DateTime
  endsAt   DateTime
  lockedAt DateTime?
  closedAt DateTime?

  notes    String?
  metadata Json @default("{}")

  createdById String?
  createdBy   User? @relation("AccountingPeriodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  vouchers AccountingVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, code])
  @@index([empresaId, status, startsAt])
  @@map("accounting_periods")
}

model AccountingVoucher {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  periodId String?
  period   AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  voucherType AccountingVoucherType
  status      AccountingVoucherStatus @default(DRAFT)

  code String
  date DateTime

  description        String
  externalReference  String?
  thirdPartyName     String?
  thirdPartyDocument String?
  currency           String @default("COP")

  totalDebit  Float @default(0)
  totalCredit Float @default(0)

  journalEntryId String? @unique
  journalEntry   AccountingJournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  notes    String?
  metadata Json @default("{}")

  createdById String?
  createdBy   User? @relation("AccountingVoucherCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User? @relation("AccountingVoucherApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  lines AccountingVoucherLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, code])
  @@index([empresaId, voucherType, date])
  @@index([empresaId, status, date])
  @@index([periodId])
  @@map("accounting_vouchers")
}

model AccountingVoucherLine {
  id        String @id @default(cuid())
  voucherId String
  voucher   AccountingVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  order Int @default(0)

  accountId String
  account   AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  costCenterId String?
  costCenter   AccountingCostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  thirdPartyName     String?
  thirdPartyDocument String?

  debit  Float @default(0)
  credit Float @default(0)
  memo   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([voucherId, order])
  @@index([accountId])
  @@index([costCenterId])
  @@map("accounting_voucher_lines")
}

model DecisionEngineSnapshot {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String?
  sede   Sede? @relation(fields: [sedeId], references: [id], onDelete: SetNull)

  scope String @db.VarChar(16)
  from  DateTime
  to    DateTime

  locale        String @default("es-CO") @db.VarChar(16)
  engineVersion String @default("v1") @db.VarChar(32)

  capturedByUserId String?

  companyHealthScore  Float
  companyHealthStatus String @db.VarChar(16)
  executiveSummary    String @db.Text

  snapshot Json

  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([empresaId, scope, createdAt])
  @@index([sedeId, createdAt])
  @@map("decision_engine_snapshots")
}

