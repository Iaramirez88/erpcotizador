// ============================================
// LITOGRAFÍA - TARIFARIO GLOBAL (POR EMPRESA)
// ============================================

model LitografiaPrintProfile {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre String

  // Costos por pliego (por color)
  costoPlanchaPorColor Float @default(0)
  costoTintaPorColor   Float @default(0)

  // Área útil máxima que la máquina/perfil puede imprimir sobre el pliego seleccionado.
  // Se cruza con el tamaño del papel para calcular la imposición real.
  anchoUtilCm         Float @default(70)
  altoUtilCm          Float @default(100)
  separacionPiezasCm  Float @default(0)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("litografia_print_profiles")
}

model LitografiaPaperRate {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre  String
  tipo    String?
  gramaje Int?

  // Tamaño de pliego base (cm)
  pliegoWidthCm  Float @default(70)
  pliegoHeightCm Float @default(100)

  // Costo por pliego
  costoPliego Float @default(0)

  activo Boolean @default(true)

  flyerRates LitografiaFlyerRate[]
  productos  LitografiaProducto[]
  requests   LitografiaPaperRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("litografia_paper_rates")
}

enum LitografiaPaperRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LitografiaPaperRequest {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdByUser   User @relation("LitografiaPaperRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  sedeId String

  approvedByUserId String?
  approvedByUser   User? @relation("LitografiaPaperRequestApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  status       LitografiaPaperRequestStatus @default(PENDING)
  decisionNote String? @db.Text

  nombre String
  tipo   String?

  gramaje Int?

  pliegoWidthCm  Float @default(70)
  pliegoHeightCm Float @default(100)
  costoPliego    Float @default(0)

  paperRateId String?
  paperRate   LitografiaPaperRate? @relation(fields: [paperRateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, status])
  @@index([empresaId, sedeId, status])
  @@index([empresaId, createdAt])
  @@map("litografia_paper_requests")
}

model LitografiaFinishOption {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  key    String
  nombre String

  grupo LitografiaFinishGroup @default(ACABADO)

  // Cuando es true, se considera un “acabado especial” (se gestiona y cotiza aparte).
  especial Boolean @default(false)

  // Valor/costo del acabado (COP). Se usa para referencia y futuras reglas.
  valor Float @default(0)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flyerRates LitografiaFlyerRate[]
  productos  LitografiaProducto[]

  @@unique([empresaId, key])
  @@index([empresaId, activo])
  @@map("litografia_finish_options")
}

enum LitografiaFinishGroup {
  ACABADO
  PLASTIFICADO
  TROQUELADO
  CORTE
}

model LitografiaPrintSize {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Debe coincidir con el formatoKey usado en tarifario y cotizador
  key    String
  nombre String

  widthCm  Float @default(0)
  heightCm Float @default(0)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, key])
  @@index([empresaId, activo])
  @@map("litografia_print_sizes")
}

model LitografiaProducto {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre      String
  descripcion String?

  // Especificación del producto (define el “ítem” y sus rangos)
  formatoKey String
  tintas     Int

  // Papel requerido para calcular pliegos/imposición
  paperRateId String
  paperRate   LitografiaPaperRate @relation(fields: [paperRateId], references: [id])

  finishOptionId String?
  finishOption   LitografiaFinishOption? @relation(fields: [finishOptionId], references: [id], onDelete: SetNull)

  activo Boolean @default(true)

  flyerRates LitografiaFlyerRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@unique([empresaId, paperRateId, formatoKey, tintas, finishOptionId])
  @@index([empresaId, activo])
  @@index([empresaId, formatoKey, tintas])
  @@map("litografia_productos")
}

model LitografiaFlyerRate {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  productoId String?
  producto   LitografiaProducto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  // Debe coincidir con LitografiaPrintSize.key (o PRODUCT_PRESETS.key si no usa tamaños configurables)
  formatoKey String

  // Solo permitidos: 1, 2, 4 (4 = policromía)
  tintas Int

  // Rango inclusivo: tirajeMin <= cantidad <= tirajeMax
  tirajeMin Int
  tirajeMax Int

  // Opcionales para tarifario completo por papel y acabado
  paperRateId String?
  paperRate   LitografiaPaperRate? @relation(fields: [paperRateId], references: [id], onDelete: SetNull)

  finishOptionId String?
  finishOption   LitografiaFinishOption? @relation(fields: [finishOptionId], references: [id], onDelete: SetNull)

  // Precio TOTAL (no unitario) para ese rango/opción
  precioTotal Float @default(0)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, formatoKey, tintas, tirajeMin, tirajeMax, paperRateId, finishOptionId])
  @@index([empresaId, formatoKey, tintas, paperRateId, finishOptionId, activo])
  @@index([empresaId, productoId, activo])
  @@index([empresaId, tirajeMin, tirajeMax])
  @@map("litografia_flyer_rates")
}

// ============================================
// CONFIGURACIÓN - DROPDOWNS PERSONALIZADOS (POR EMPRESA)
// ============================================

model ConfigDropdown {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Key estable para referenciar el dropdown (ej: "transporte", "tiraje_tiers", "mis_opciones")
  key   String
  nombre String

  descripcion String?

  items ConfigDropdownItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, key])
  @@index([empresaId])
  @@map("config_dropdowns")
}

model ConfigDropdownItem {
  id String @id @default(cuid())

  dropdownId String
  dropdown   ConfigDropdown @relation(fields: [dropdownId], references: [id], onDelete: Cascade)

  // Value estable para almacenar el valor seleccionado
  value String
  // Label visible para el usuario
  label String

  // Metadata opcional por opción (ej: { total: 20000 } o { min: 1, max: 500 })
  meta Json @default("{}")

  sortOrder Int @default(0)
  activo    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dropdownId, value])
  @@index([dropdownId, activo])
  @@index([dropdownId, sortOrder])
  @@map("config_dropdown_items")
}

model InventoryMovement {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Multi-sede / bodega (para POS y control por almacén)
  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: SetNull)

  warehouseId String?
  warehouse   InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  type     InventoryMovementType
  // Delta aplicado (IN: positivo, OUT: negativo, ADJUST: diferencia)
  quantity Float

  stockBefore Float
  stockAfter  Float

  note String?

  sourceType InventoryMovementSourceType @default(MANUAL)
  sourceId   String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([sedeId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([sourceType, sourceId])
  @@index([materialId, createdAt])
  @@map("inventory_movements")
}

model InventoryWarehouse {
  id        String  @id @default(cuid())
  nombre    String
  codigo    String?
  isDefault Boolean @default(false)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Multi-sede (opcional por compatibilidad / despliegues iniciales)
  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  stocks    InventoryStock[]
  movements InventoryMovement[]

  posInvoices PosInvoice[]
  posReturns  PosReturn[]

  remisiones Remision[]
  
  transfersFrom InventoryTransfer[] @relation("TransfersFrom")
  transfersTo   InventoryTransfer[] @relation("TransfersTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, sedeId, nombre])
  @@index([empresaId])
  @@index([sedeId])
  @@map("inventory_warehouses")
}

model InventoryStock {
  id          String             @id @default(cuid())
  warehouseId String
  warehouse   InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  quantity Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, materialId])
  @@index([materialId])
  @@map("inventory_stocks")
}

model InventoryTransfer {
  id     String @id @default(cuid())
  numero String @unique

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Bodega origen
  fromWarehouseId String
  fromWarehouse   InventoryWarehouse @relation("TransfersFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)

  // Bodega destino
  toWarehouseId String
  toWarehouse   InventoryWarehouse @relation("TransfersTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  quantity Float
  note     String?

  status InventoryTransferStatus @default(PENDIENTE)

  createdById String?
  createdBy   User?   @relation("TransferCreated", fields: [createdById], references: [id], onDelete: SetNull)

  completedById String?
  completedBy   User?    @relation("TransferCompleted", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, createdAt])
  @@index([fromWarehouseId, createdAt])
  @@index([toWarehouseId, createdAt])
  @@index([materialId, createdAt])
  @@index([status])
  @@map("inventory_transfers")
}

model PosSequence {
  id     String @id @default(cuid())
  sedeId String @unique
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  nextInvoiceNumber Int @default(1)
  nextReturnNumber  Int @default(1)

  updatedAt DateTime @updatedAt

  @@map("pos_sequences")
}

model CotizacionSequence {
  sedeId String @id
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  currentNumber Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cotizacion_sequences")
}

model PosInvoice {
  id     String           @id @default(cuid())
  numero String           @unique
  status PosInvoiceStatus @default(PAID)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  cotizacionId String?     @unique
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: SetNull)

  clienteNombre    String
  clienteDocumento String?

  ivaPct   Float @default(0)
  subtotal Float @default(0)
  discountAmount   Float @default(0)
  otherTaxesAmount Float @default(0)
  iva      Float @default(0)
  total    Float @default(0)

  note String? @db.Text

  items    PosInvoiceItem[]
  payments PosPayment[]
  returns  PosReturn[]
  auditEvents PosInvoiceAuditEvent[]

  // DIAN (documentos electrónicos)
  dianDocuments DianElectronicDocument[] @relation("DianDocPosInvoice")

  ordenTrabajo OrdenTrabajo? @relation("PosInvoiceOrden")

  createdById String?
  createdBy   User?   @relation("PosInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, createdAt])
  @@index([sedeId, createdAt])
  @@index([clienteId])
  @@map("pos_invoices")
}

enum PosInvoiceAuditAction {
  CREATED
  UPDATED
  SHARED_EMAIL
  SHARED_WHATSAPP
  PDF_DOWNLOADED
}

model PosInvoiceAuditEvent {
  id String @id @default(cuid())

  invoiceId String
  invoice   PosInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  action PosInvoiceAuditAction
  note   String? @db.Text
  before Json?
  after  Json?

  performedById String?
  performedBy   User? @relation("PosInvoiceAuditPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@index([action, createdAt])
  @@map("pos_invoice_audit_events")
}

model PosInvoiceItem {
  id        String     @id @default(cuid())
  invoiceId String
  invoice   PosInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  descripcion String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([materialId])
  @@map("pos_invoice_items")
}

model PosPayment {
  id        String     @id @default(cuid())
  invoiceId String
  invoice   PosInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  method   PosPaymentMethod
  status   PosPaymentStatus   @default(PAID)
  provider PosPaymentProvider @default(MANUAL)
  flow     PosPaymentFlow     @default(CASH)
  source   PosPaymentSource   @default(NONE)
  amount   Float              @default(0)
  note     String?

  externalReference String? @unique

  boldPaymentLinkId String? @unique
  boldCheckoutUrl   String?
  boldPaymentId     String?
  boldEventId       String?
  boldType          String?

  paidAt   DateTime?
  metadata Json      @default("{}")

  receivedAt DateTime @default(now())

  @@index([invoiceId])
  @@index([status, provider])
  @@index([externalReference])
  @@map("pos_payments")
}

model PosReturn {
  id     String @id @default(cuid())
  numero String @unique

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   PosInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  motivo   String? @db.Text
  ivaPct   Float   @default(0)
  subtotal Float   @default(0)
  iva      Float   @default(0)
  total    Float   @default(0)

  items PosReturnItem[]

  // DIAN (documentos electrónicos)
  dianDocuments DianElectronicDocument[] @relation("DianDocPosReturn")

  createdById String?
  createdBy   User?   @relation("PosReturnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([empresaId, createdAt])
  @@index([sedeId, createdAt])
  @@index([invoiceId])
  @@map("pos_returns")
}

model PosReturnItem {
  id        String    @id @default(cuid())
  returnId  String
  posReturn PosReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  descripcion String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)

  @@index([returnId])
  @@index([materialId])
  @@map("pos_return_items")
}

model DianElectronicDocument {
  id        String @id @default(cuid())
  direction DianDocumentDirection @default(OUTBOUND)
  type      DianDocumentType
  status    DianDocumentStatus @default(GENERATED)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  sedeId String
  sede   Sede @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  // Opcional: documento interno origen
  posInvoiceId String?
  posInvoice   PosInvoice? @relation("DianDocPosInvoice", fields: [posInvoiceId], references: [id], onDelete: SetNull)

  posReturnId String?
  posReturn   PosReturn? @relation("DianDocPosReturn", fields: [posReturnId], references: [id], onDelete: SetNull)

  // Identificadores y payload
  numero      String?
  uuid        String?
  cufe        String? @db.Text
  provider    String?
  providerRef String?

  payload Json @default("{}")
  xml     String? @db.Text

  lastError String? @db.Text

  transmittedAt DateTime?
  expeditedAt   DateTime?
  deliveredAt   DateTime?
  receivedAt    DateTime?

  createdById String?
  createdBy   User? @relation("DianDocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  events DianElectronicEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, createdAt])
  @@index([sedeId, createdAt])
  @@index([direction, status, createdAt])
  @@index([posInvoiceId])
  @@index([posReturnId])
  @@map("dian_electronic_documents")
}

model DianElectronicEvent {
  id         String @id @default(cuid())
  documentId String
  document   DianElectronicDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  type    DianEventType
  message String? @db.Text
  meta    Json @default("{}")

  createdAt DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([type, createdAt])
  @@map("dian_electronic_events")
}

model BillingInvoice {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  provider BillingProvider      @default(BOLD)
  status   BillingInvoiceStatus @default(PENDING)

  planTier     PlanTier
  billingCycle BillingCycle

  currency    String @default("COP")
  amountCOP   Int
  discountPct Int    @default(0)
  quotedModulesJson Json @default("[]")

  externalReference String @unique

  boldPaymentLinkId String? @unique
  boldCheckoutUrl   String?
  boldPaymentId     String?
  boldEventId       String?
  boldType          String?
  paymentMethod     String?

  expiresAt DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([empresaId, status])
  @@index([externalReference])
  @@map("billing_invoices")
