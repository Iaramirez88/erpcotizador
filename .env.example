APP_URL=https://tu-dominio.com
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=tu_clave_publica_vapid
WEB_PUSH_PRIVATE_KEY=tu_clave_privada_vapid
WEB_PUSH_SUBJECT=mailto:soporte@tu-dominio.com
# Base de datos PostgreSQL
# Para usar Supabase (gratis): Crea proyecto en https://supabase.com y copia la connection string
# Para PostgreSQL local: postgresql://postgres:tupassword@localhost:5432/sgdigital_cotizador
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgdigital_cotizador"
 
# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
# OBLIGATORIO: genera uno con
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (ver INSTALACION.md, Paso 3)
NEXTAUTH_SECRET=""

# URL pública/base de la app.
# Se usa para construir callbacks y links compartidos (ej. WhatsApp/PDF público).
# En local para abrir desde el celular, usa la IP del PC en tu red:
# APP_URL="http://192.168.1.50:3000"
APP_URL="http://localhost:3000"
# En producción: sgdigitalordex.com. Vacío mantiene rutas /sites/* en desarrollo.
NEXT_PUBLIC_WEBSITE_BASE_DOMAIN=
# Destinos aceptados al verificar dominios personalizados (listas separadas por coma).
WEBSITE_DOMAIN_CNAME_TARGET="edge.sgdigitalordex.com"
WEBSITE_DOMAIN_IPV4=""
WEBSITE_DOMAIN_IPV6=""

# Cloudflare Turnstile para formularios públicos. Configura ambas o deja ambas vacías.
# La clave pública se integra durante `npm run build`.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTS="sgdigitalordex.com"
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=5
PUBLIC_FORM_RATE_LIMIT_PER_HOUR=30
PUBLIC_FORM_RATE_LIMIT_CHANNEL_DAILY=2000

# Tokens para compartir cotizaciones públicamente (PDF).
# Si no se define, el sistema usará NEXTAUTH_SECRET.
SHARE_TOKEN_SECRET=""

# Auth.js (NextAuth v5)
# En `npm start` (NODE_ENV=production) Auth.js exige host confiable.
# Para desarrollo/local, esto evita: [auth][error] UntrustedHost
AUTH_TRUST_HOST="true"

# Email con Resend
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="SGDigital <noreply@tudominio.com>"
CONTABILIDAD_EMAIL="contabilidad@tuempresa.com"

# Opcionales para OAuth (Google, GitHub, etc.)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Redirect URI en Google Cloud Console:
# http://localhost:3000/api/auth/callback/google
# Producción:
# https://tu-dominio.com/api/auth/callback/google

# Google Marketing: Ads, Analytics y Search Console.
# En producción, el origen debe coincidir con APP_URL y con la URI autorizada en Google Cloud.
GOOGLE_MARKETING_CLIENT_ID=""
GOOGLE_MARKETING_CLIENT_SECRET=""
GOOGLE_MARKETING_REDIRECT_URI="https://sgdigitalordex.com/api/oauth/google-marketing/callback"
# Desde el 9 de septiembre de 2026 Google Ads usa el nivel de acceso del proyecto Cloud.
# GOOGLE_ADS_DEVELOPER_TOKEN ya no se utiliza.
GOOGLE_ADS_API_VERSION="v25"
# ID de la cuenta administradora MCC, solo números. Nunca uses aquí la cuenta operativa.
GOOGLE_ADS_LOGIN_CUSTOMER_ID="" # Ejemplo: 7889973249

# CRM omnicanal / Meta OAuth
META_APP_ID=""
META_APP_SECRET=""
# Facebook Login for Business / Business Login configurations (recomendado)
# Si defines estos IDs, el CRM usará config_id en vez de scopes manuales.
META_CONFIG_ID=""
META_WHATSAPP_CONFIG_ID=""
META_INSTAGRAM_CONFIG_ID=""
META_FACEBOOK_PAGE_CONFIG_ID=""

# IA litográfica (endpoint OpenAI-compatible: OpenAI, Ollama, OpenRouter, Groq, etc.)
# Si se deja vacío, la pestaña "Cotice con IA" usará el motor interno por reglas.
#
# OpenAI mínimo:
# LITOGRAFIA_AI_API_KEY="sk-..."
# LITOGRAFIA_AI_MODEL="gpt-4.1-mini"
#
# Ollama mínimo:
# LITOGRAFIA_AI_PROVIDER="ollama"
# LITOGRAFIA_AI_MODEL="llama3.1:8b"
# LITOGRAFIA_AI_BASE_URL="http://127.0.0.1:11434/v1"
LITOGRAFIA_AI_BASE_URL=""
LITOGRAFIA_AI_API_KEY=""
LITOGRAFIA_AI_MODEL=""
LITOGRAFIA_AI_PROVIDER="openai-compatible"

# Verificación de dominio para Meta / Facebook Business Manager.
# Se renderiza como: <meta name="facebook-domain-verification" content="..." />
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=""

# Se usa para cifrar tokens de canales CRM. Si no se define, se usa NEXTAUTH_SECRET.
CRM_CHANNEL_SECRET=""

# Rank Tracker SEO con DataForSEO Standard Queue.
# Usa DATAFORSEO_MODE="sandbox" para validar la integración sin consumir crédito.
# En producción usa "live" y ejecuta periódicamente:
# 0 */2 * * * curl -X POST https://sgdigitalordex.com/api/admin/jobs/seo-rank-tracker -H "X-API-Key: $ADMIN_API_KEY"
# 15 3 * * * curl -X POST https://sgdigitalordex.com/api/admin/jobs/seo-audits -H "X-API-Key: $ADMIN_API_KEY"
# 30 4 * * * curl -X POST https://sgdigitalordex.com/api/admin/jobs/seo-search-console -H "X-API-Key: $ADMIN_API_KEY"
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
DATAFORSEO_MODE="sandbox"
DATAFORSEO_MONTHLY_BUDGET_USD="10"
DATAFORSEO_ESTIMATED_COST_PER_SERP_USD="0.0006"
ADMIN_API_KEY=""

# PageSpeed Insights / Lighthouse. No es la misma credencial de OAuth Marketing.
PAGESPEED_API_KEY=""