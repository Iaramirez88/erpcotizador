{
  # Email recomendado para Let's Encrypt (opcional)
  # email admin@tu-dominio.com
  on_demand_tls {
    ask http://app:3000/api/public/sites/allow-domain
  }
}

# Hosts que van a servir la app.
sgdigitalordex.com, www.sgdigitalordex.com {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=()"
  }

  # Ajusta si quieres límites/timeout adicionales
  reverse_proxy app:3000
}

# Sitios gratuitos publicados como empresa.sgdigitalordex.com.
# Requiere un registro DNS wildcard *.sgdigitalordex.com apuntando a este servidor.
https:// {
  tls {
    on_demand
  }

  encode zstd gzip
  reverse_proxy app:3000
}
