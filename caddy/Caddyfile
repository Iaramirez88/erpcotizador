{
  # Email recomendado para Let's Encrypt (opcional)
  # email admin@tu-dominio.com
  on_demand_tls {
    ask http://app:3000/api/public/sites/allow-domain
  }
}

# Hosts que van a servir la app.
joinclap.com.co, www.joinclap.com.co {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=()"
  }

  # Ajusta si quieres límites/timeout adicionales
  reverse_proxy app:3000
}

# Sitios gratuitos publicados como empresa.joinclap.com.co.
# Requiere un registro DNS wildcard *.joinclap.com.co apuntando a este servidor.
https:// {
  tls {
    on_demand
  }

  encode zstd gzip
  reverse_proxy app:3000
}

# Fase 8 — Redirección 301 del dominio antiguo al nuevo (recomendado).
# Conserva la ruta con {uri}: los enlaces viejos caen en el dominio nuevo.
sgdigitalordex.com, www.sgdigitalordex.com {
    redir https://joinclap.com.co{uri} permanent
}
